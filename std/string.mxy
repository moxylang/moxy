// std/string.mxy — helpers on top of the string methods
// (s.len, s.contains(x), s.split(sep), s.trim(), s.upper(), s.replace(a, b), ...)

int str_len(string s) { return (int)s.len; }
bool str_eq(string a, string b) { return a == b; }
bool str_contains(string haystack, string needle) { return haystack.contains(needle); }
bool str_starts_with(string s, string prefix) { return s.starts_with(prefix); }
bool str_ends_with(string s, string suffix) { return s.ends_with(suffix); }

string join(string[] parts, string sep) { return parts.join(sep); }

string pad_left(string s, int width, char fill) {
    string out = s;
    while (out.len < width) { out = string(fill) + out; }
    return out;
}

string pad_right(string s, int width, char fill) {
    string out = s;
    while (out.len < width) { out = out + string(fill); }
    return out;
}

string reverse(string s) {
    string out = "";
    for i in 0..s.len { out = out + string(s[s.len - 1 - i]); }
    return out;
}

int count(string s, string sub) {
    if (sub.len == 0) { return 0; }
    return (int)s.split(sub).len - 1;
}
