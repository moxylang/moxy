// std/test.mxy — assertions with readable failure messages.
// assert(condition) and assert(condition, "message") are built in.

void assert_eq_int(long got, long want) {
    if (got != want) { panic("expected \(want), got \(got)"); }
}

void assert_eq_float(double got, double want, double tolerance) {
    double diff = got - want;
    if (diff < 0) { diff = -diff; }
    if (diff > tolerance) { panic("expected \(want), got \(got)"); }
}

void assert_eq_str(string got, string want) {
    if (got != want) { panic("expected \"\(want)\", got \"\(got)\""); }
}

void assert_true(bool cond) {
    if (!cond) { panic("expected true"); }
}

void assert_false(bool cond) {
    if (cond) { panic("expected false"); }
}
