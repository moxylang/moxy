#include "index.mxy"

#include <stdio.h>
#include <string.h>

Parser P;

Token *peek(void) { return &P.toks[P.pos]; }

Token *peek_at(int ahead) {
    int i = P.pos + ahead;
    if (i >= P.len) i = P.len - 1;
    if (i < 0) i = 0;
    return &P.toks[i];
}

Token *next(void) {
    Token *t = &P.toks[P.pos];
    if (t->kind != T_EOF) P.pos++;
    return t;
}

int at(TokKind kind) { return peek()->kind == kind; }

int word_at(int ahead, const char *word) {
    Token *t = peek_at(ahead);
    return t->kind == T_IDENT && strcmp(t->text, word) == 0;
}

int at_word(const char *word) { return word_at(0, word); }

int accept(TokKind kind) {
    if (!at(kind)) return 0;
    next();
    return 1;
}

_Noreturn void fail(Loc loc, const char *fmt, ...) {
    va_list ap;
    va_start(ap, fmt);
    char *msg = xvfmt(fmt, ap);
    va_end(ap);
    diag_error(loc, "%s", msg);
    free(msg);
    diag_bail();
}

static const char *describe(Token *t) {
    if (t->kind == T_EOF) return "end of file";
    if (t->kind == T_STR) return "string literal";
    static char buf[96];
    snprintf(buf, sizeof(buf), "'%.60s'", t->text);
    return buf;
}

Token *expect(TokKind kind, const char *what) {
    Token *t = peek();
    if (t->kind == kind) return next();
    Loc loc = t->loc;
    if (kind == P_SEMI && P.pos > 0) {
        Token *prev = &P.toks[P.pos - 1];
        loc = prev->loc;
        loc.col += prev->loc.span;
        loc.span = 1;
    }
    diag_error(loc, "expected %s, found %s", what ? what : tok_name(kind), describe(t));
    if (kind == P_SEMI) diag_hint("add ';' at the end of the statement");
    else if (kind == P_RPAREN) diag_hint("unclosed '(' — add ')' to match");
    else if (kind == P_RBRACE) diag_hint("unclosed '{' — add '}' to match");
    else if (kind == P_RBRACKET) diag_hint("unclosed '[' — add ']' to match");
    diag_bail();
}

/* index of the token matching the opener at `open`, or -1 */
int match_paren(int open) {
    TokKind o = P.toks[open].kind;
    TokKind c = o == P_LPAREN ? P_RPAREN : o == P_LBRACKET ? P_RBRACKET : P_RBRACE;
    int depth = 0;
    for (int i = open; i < P.len; i++) {
        TokKind k = P.toks[i].kind;
        if (k == o) depth++;
        else if (k == c && --depth == 0) return i;
        else if (k == T_EOF) return -1;
    }
    return -1;
}

/* ---- known type names ---------------------------------------------- */

typedef struct {
    char **slots;
    int cap;
    int len;
} NameSet;

static NameSet names;

static unsigned hash(const char *s) {
    unsigned h = 2166136261u;
    for (; *s; s++) h = (h ^ (unsigned char)*s) * 16777619u;
    return h;
}

static void set_grow(void) {
    NameSet old = names;
    names.cap = old.cap ? old.cap * 2 : 256;
    names.slots = xcalloc((size_t)names.cap, sizeof(char *));
    names.len = 0;
    for (int i = 0; i < old.cap; i++)
        if (old.slots[i]) types_add(old.slots[i]);
    for (int i = 0; i < old.cap; i++) free(old.slots[i]);
    free(old.slots);
}

void types_add(const char *name) {
    if (names.len * 2 >= names.cap) set_grow();
    unsigned i = hash(name) & (unsigned)(names.cap - 1);
    while (names.slots[i]) {
        if (strcmp(names.slots[i], name) == 0) return;
        i = (i + 1) & (unsigned)(names.cap - 1);
    }
    names.slots[i] = xstrdup(name);
    names.len++;
}

int types_has(const char *name) {
    if (!names.cap) return 0;
    unsigned i = hash(name) & (unsigned)(names.cap - 1);
    while (names.slots[i]) {
        if (strcmp(names.slots[i], name) == 0) return 1;
        i = (i + 1) & (unsigned)(names.cap - 1);
    }
    return 0;
}

static const char *c_typedefs[] = {
    "size_t", "ssize_t", "ptrdiff_t", "intptr_t", "uintptr_t", "intmax_t", "uintmax_t",
    "int8_t", "int16_t", "int32_t", "int64_t", "uint8_t", "uint16_t", "uint32_t",
    "uint64_t", "wchar_t", "FILE", "va_list", "time_t", "clock_t", "pid_t", "off_t",
    "mode_t", "uid_t", "gid_t", "socklen_t", "pthread_t", "pthread_mutex_t",
    "pthread_cond_t", "pthread_attr_t", "jmp_buf", "fpos_t", "DIR", "sig_atomic_t",
    "max_align_t", "div_t", "ldiv_t", "char16_t", "char32_t", "errno_t", "in_addr_t",
    "in_port_t", "sa_family_t", "fd_set", "useconds_t", "suseconds_t", "dev_t", "ino_t",
    "nlink_t", "blksize_t", "blkcnt_t", "regex_t", "regmatch_t", "locale_t", "tm",
    NULL,
};

void types_reset(void) {
    for (int i = 0; i < names.cap; i++) free(names.slots[i]);
    free(names.slots);
    names.slots = NULL;
    names.cap = names.len = 0;
    for (int i = 0; c_typedefs[i]; i++) types_add(c_typedefs[i]);
}

/* learn type names declared anywhere so use-before-declaration parses */
void types_prescan(void) {
    for (int i = 0; i < P.len; i++) {
        Token *t = &P.toks[i];
        if ((t->kind == K_STRUCT || t->kind == K_UNION || t->kind == K_ENUM) &&
            P.toks[i + 1].kind == T_IDENT) {
            types_add(P.toks[i + 1].text);
            continue;
        }
        if (t->kind == P_AT && i + 1 < P.len && strcmp(P.toks[i + 1].text, "type") == 0) {
            for (int j = i + 2; j < P.len; j++) {
                Token *u = &P.toks[j];
                if (u->kind == T_IDENT && !(u->bol && j > i + 2)) types_add(u->text);
                else if (u->kind != P_COMMA) break;
                if (j + 1 < P.len && P.toks[j + 1].bol) break;
            }
            continue;
        }
        if (t->kind != K_TYPEDEF) continue;
        int brace = 0, paren = 0;
        for (int j = i + 1; j < P.len; j++) {
            Token *u = &P.toks[j];
            if (u->kind == T_EOF) break;
            if (u->kind == P_LBRACE) brace++;
            else if (u->kind == P_RBRACE) brace--;
            else if (u->kind == P_LPAREN) paren++;
            else if (u->kind == P_RPAREN) paren--;
            if (brace > 0) continue;
            if (u->kind == P_SEMI && brace == 0) break;
            if (u->kind != T_IDENT) continue;
            TokKind nk = P.toks[j + 1].kind;
            Token *prev = &P.toks[j - 1];
            if (paren == 0 && (nk == P_SEMI || nk == P_COMMA || nk == P_LBRACKET))
                types_add(u->text);
            else if (paren == 1 && nk == P_RPAREN && prev->kind == P_STAR)
                types_add(u->text);
            else if (paren == 0 && nk == P_LPAREN && prev->kind != P_STAR &&
                     (prev->kind != T_IDENT || types_has(prev->text) || prev->kind >= K_AUTO))
                types_add(u->text);
        }
    }
}

int is_type_name(Token *t) {
    return t->kind == T_IDENT && types_has(t->text);
}

static int is_type_keyword(TokKind k) {
    switch (k) {
    case K_VOID: case K_CHAR: case K_SHORT: case K_INT: case K_LONG: case K_FLOAT:
    case K_DOUBLE: case K_SIGNED: case K_UNSIGNED: case K_BOOL: case K_STRING:
    case K_STRUCT: case K_UNION: case K_ENUM: case K_CONST: case K_VOLATILE:
    case K_RESTRICT:
        return 1;
    default:
        return 0;
    }
}

/* contextual Moxy type constructors: map[K,V], Result<T>, Future<T>, fn(..) */
static int moxy_type_at(int ahead) {
    Token *t = peek_at(ahead);
    if (t->kind != T_IDENT) return 0;
    TokKind n = peek_at(ahead + 1)->kind;
    if (strcmp(t->text, "Result") == 0 || strcmp(t->text, "Future") == 0) return n == P_LT;
    if (strcmp(t->text, "map") == 0 && n == P_LBRACKET) {
        int close = match_paren(P.pos + ahead + 1);
        if (close < 0) return 0;
        for (int i = P.pos + ahead + 2; i < close; i++)
            if (P.toks[i].kind == P_COMMA) return 1;
        return 0;
    }
    if (strcmp(t->text, "fn") == 0 && n == P_LPAREN) {
        int close = match_paren(P.pos + ahead + 1);
        return close > 0 && (P.toks[close + 1].kind == P_ARROW || P.toks[close + 1].kind == T_IDENT ||
                             P.toks[close + 1].kind == P_RPAREN || P.toks[close + 1].kind == P_COMMA ||
                             P.toks[close + 1].kind == P_GT || P.toks[close + 1].kind == P_RBRACKET);
    }
    return 0;
}

int is_type_start_at(int ahead) {
    Token *t = peek_at(ahead);
    if (is_type_keyword(t->kind)) return 1;
    if (moxy_type_at(ahead)) return 1;
    if (t->kind == T_IDENT && strcmp(t->text, "weak") == 0 && peek_at(ahead + 1)->kind == T_IDENT) return 1;
    if (t->kind != T_IDENT) return 0;
    /* namespaced type: a::b::T */
    int i = ahead;
    while (peek_at(i + 1)->kind == P_COLONCOLON && peek_at(i + 2)->kind == T_IDENT) i += 2;
    return is_type_name(peek_at(i));
}

/* statement position: does a declaration start here? */
int is_decl_start(void) {
    Token *t = peek();
    switch (t->kind) {
    case K_STATIC: case K_EXTERN: case K_TYPEDEF: case K_REGISTER: case K_AUTO:
    case K_INLINE: case K_THREAD_LOCAL: case K_NORETURN:
        return 1;
    default:
        break;
    }
    if (t->kind != T_IDENT) return is_type_start_at(0);
    if (moxy_type_at(0)) return 1;
    if (strcmp(t->text, "await") == 0 && !types_has("await")) return 0;
    int i = 0;
    while (peek_at(i + 1)->kind == P_COLONCOLON && peek_at(i + 2)->kind == T_IDENT) i += 2;
    Token *after = peek_at(i + 1);
    if (is_type_name(peek_at(i))) {
        if (after->kind == P_LBRACE || after->kind == P_LPAREN || after->kind == P_DOT ||
            after->kind == P_ARROW || after->kind == P_ASSIGN)
            return 0;
        return 1;
    }
    if (i > 0) return 0;
    /* unknown identifier: `T name` or `T *name =` reads as a declaration */
    if (after->kind == T_IDENT) return !word_at(1, "in");
    if (after->kind == P_STAR) {
        int j = 1;
        while (peek_at(j)->kind == P_STAR) j++;
        if (peek_at(j)->kind != T_IDENT) return 0;
        TokKind k = peek_at(j + 1)->kind;
        return k == P_SEMI || k == P_ASSIGN || k == P_COMMA || k == P_LBRACKET;
    }
    if (after->kind == P_LBRACKET && peek_at(2)->kind == P_RBRACKET && peek_at(3)->kind == T_IDENT) return 1;
    return 0;
}
