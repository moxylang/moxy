#include <string.h>

#include "index.mxy"

static int quals_of(TokKind k) {
    switch (k) {
    case K_CONST: return Q_CONST;
    case K_VOLATILE: return Q_VOLATILE;
    case K_RESTRICT: return Q_RESTRICT;
    default: return 0;
    }
}

static TypeRef *name_ref(const char *name, Loc loc) {
    TypeRef *t = tref_new(TR_NAME, loc);
    t->name = xstrdup(name);
    return t;
}

static TypeRef *list_suffix(TypeRef *base) {
    while (at(P_LBRACKET) && peek_at(1)->kind == P_RBRACKET) {
        Loc loc = peek()->loc;
        next();
        next();
        TypeRef *l = tref_new(TR_LIST, loc);
        l->inner = base;
        base = l;
    }
    return base;
}

/* Result<T>, Future<T>, map[K, V], fn(A, B) -> R */
static TypeRef *moxy_type(void) {
    Token *t = next();
    Loc loc = t->loc;
    if (strcmp(t->text, "Result") == 0 || strcmp(t->text, "Future") == 0) {
        TypeRef *r = tref_new(t->text[0] == 'R' ? TR_RESULT : TR_FUTURE, loc);
        expect(P_LT, "'<'");
        r->inner = parse_type_name();
        if (at(P_SHR)) {
            /* `>>` closing two generics: split the token */
            peek()->kind = P_GT;
            peek()->loc.col++;
        } else {
            expect(P_GT, "'>'");
        }
        return r;
    }
    if (strcmp(t->text, "map") == 0) {
        TypeRef *r = tref_new(TR_MAP, loc);
        expect(P_LBRACKET, "'['");
        r->key = parse_type_name();
        expect(P_COMMA, "','");
        r->inner = parse_type_name();
        expect(P_RBRACKET, "']'");
        return r;
    }
    TypeRef *r = tref_new(TR_CLOSURE, loc);
    expect(P_LPAREN, "'('");
    while (!at(P_RPAREN)) {
        vec_push(r->params, parse_type_name());
        if (!accept(P_COMMA)) break;
    }
    expect(P_RPAREN, "')'");
    if (accept(P_ARROW)) r->inner = parse_type_name();
    else r->inner = name_ref("void", loc);
    return r;
}

/* the merged spelling of builtin arithmetic keywords */
static char *builtin_name(int sign, int shorts, int longs, int base) {
    Buf b = {0};
    if (sign == K_UNSIGNED) buf_put(&b, "unsigned ");
    else if (sign == K_SIGNED && base == K_CHAR) buf_put(&b, "signed ");
    if (base == K_DOUBLE) buf_put(&b, longs ? "long double" : "double");
    else if (base == K_CHAR) buf_put(&b, "char");
    else if (shorts) buf_put(&b, "short");
    else if (longs >= 2) buf_put(&b, "long long");
    else if (longs == 1) buf_put(&b, "long");
    else if (base == K_FLOAT) buf_put(&b, "float");
    else if (base == K_VOID) buf_put(&b, "void");
    else if (base == K_BOOL) buf_put(&b, "bool");
    else if (base == K_STRING) buf_put(&b, "string");
    else buf_put(&b, "int");
    return buf_take(&b);
}

int parse_specifiers(Specs *out) {
    memset(out, 0, sizeof(*out));
    int quals = 0, sign = 0, shorts = 0, longs = 0, base = 0, saw = 0, weak = 0;
    Loc loc = peek()->loc;
    TypeRef *named = NULL;
    for (;;) {
        Token *t = peek();
        switch (t->kind) {
        case K_STATIC: out->storage |= F_STATIC; next(); continue;
        case K_EXTERN: out->storage |= F_EXTERN; next(); continue;
        case K_INLINE: out->storage |= F_INLINE; next(); continue;
        case K_NORETURN: out->storage |= F_NORETURN; next(); continue;
        case K_THREAD_LOCAL: out->storage |= F_THREADLOCAL; next(); continue;
        case K_REGISTER: next(); continue;
        case K_TYPEDEF: out->is_typedef = 1; next(); continue;
        case K_AUTO:
            next();
            if (!saw && !is_type_start_at(0)) out->is_auto = 1;
            continue;
        case K_CONST: case K_VOLATILE: case K_RESTRICT:
            quals |= quals_of(t->kind);
            next();
            continue;
        case K_UNSIGNED: case K_SIGNED: sign = t->kind; saw = 1; next(); continue;
        case K_SHORT: shorts = 1; saw = 1; next(); continue;
        case K_LONG: longs++; saw = 1; next(); continue;
        case K_VOID: case K_CHAR: case K_INT: case K_FLOAT: case K_DOUBLE: case K_BOOL: case K_STRING:
            if (base || named) break;
            base = t->kind;
            saw = 1;
            next();
            continue;
        case K_STRUCT: case K_UNION: case K_ENUM: {
            if (base || named || sign || shorts || longs) break;
            Token *kw = next();
            TypeRef *tag = tref_new(TR_TAG, kw->loc);
            tag->tag = kw->kind;
            if (at(T_IDENT)) tag->name = xstrdup(next()->text);
            if (at(P_LBRACE)) {
                Node *def;
                if (kw->kind == K_ENUM) {
                    def = node_new(N_CENUM, kw->loc);
                    def->name = tag->name;
                    parse_cenum_body(def);
                } else {
                    def = node_new(N_STRUCT, kw->loc);
                    def->name = tag->name;
                    if (kw->kind == K_UNION) def->flags |= F_UNION;
                    parse_struct_body(def);
                }
                tag->def = def;
            } else if (!tag->name) {
                fail(kw->loc, "expected a name or '{' after '%s'", kw->text);
            }
            named = tag;
            saw = 1;
            if (tag->def && peek()->bol && !at(P_SEMI)) break;
            continue;
        }
        case T_IDENT:
            if (base || named || sign || shorts || longs) break;
            if (strcmp(t->text, "weak") == 0 && peek_at(1)->kind == T_IDENT && !weak) {
                weak = 1;
                next();
                continue;
            }
            if (is_type_start_at(0)) {
                Token *n = peek();
                if ((strcmp(n->text, "Result") == 0 || strcmp(n->text, "Future") == 0 ||
                     strcmp(n->text, "map") == 0 || strcmp(n->text, "fn") == 0) &&
                    !types_has(n->text)) {
                    named = moxy_type();
                } else {
                    Buf b = {0};
                    buf_put(&b, next()->text);
                    while (at(P_COLONCOLON) && peek_at(1)->kind == T_IDENT) {
                        next();
                        buf_put(&b, "::");
                        buf_put(&b, next()->text);
                    }
                    named = name_ref(buf_str(&b), t->loc);
                    buf_free(&b);
                }
                saw = 1;
                continue;
            }
            if (!saw && !out->is_auto && (peek_at(1)->kind == T_IDENT ||
                         (peek_at(1)->kind == P_STAR && peek_at(2)->kind == T_IDENT))) {
                /* unknown C typedef from a header */
                named = name_ref(next()->text, t->loc);
                saw = 1;
                continue;
            }
            break;
        default:
            break;
        }
        break;
    }
    if (!saw && !out->is_auto) {
        if (!out->storage && !out->is_typedef && !quals) return 0;
        base = K_INT;
    }
    TypeRef *tr;
    if (out->is_auto && !saw) tr = name_ref("auto", loc);
    else if (named) tr = named;
    else tr = name_ref(builtin_name(sign, shorts, longs, base), loc);
    tr->quals |= quals;
    while (quals_of(peek()->kind)) tr->quals |= quals_of(next()->kind);
    tr = list_suffix(tr);
    if (weak) out->storage |= F_WEAK;
    out->base = tr;
    return 1;
}

/* parameter list after '(' has been consumed; stops at ')' */
void parse_params(ParamList *out, TypeRefList *types, int *variadic) {
    *variadic = 0;
    if (at(K_VOID) && peek_at(1)->kind == P_RPAREN) {
        next();
        expect(P_RPAREN, "')'");
        return;
    }
    while (!at(P_RPAREN)) {
        if (accept(P_ELLIPSIS)) {
            *variadic = 1;
            break;
        }
        Specs sp;
        Loc ploc = peek()->loc;
        if (!parse_specifiers(&sp)) fail(peek()->loc, "expected a parameter type");
        char *name = NULL;
        Loc nameloc = ploc;
        TypeRef *t = parse_declarator(sp.base, &name, NULL, &nameloc);
        if (out) {
            Param p = {name, t, nameloc, NULL};
            vec_push(*out, p);
        }
        if (types) vec_push(*types, t);
        if (!accept(P_COMMA)) break;
    }
    expect(P_RPAREN, "')'");
}

static TypeRef *suffixes(TypeRef *base, ParamList *fparams) {
    if (at(P_LBRACKET)) {
        Loc loc = next()->loc;
        Node *size = NULL;
        while (accept(K_STATIC) || accept(K_CONST) || accept(K_RESTRICT)) {
        }
        if (!at(P_RBRACKET)) size = parse_assign();
        expect(P_RBRACKET, "']'");
        TypeRef *elem = suffixes(base, NULL);
        TypeRef *arr = tref_new(TR_ARRAY, loc);
        arr->inner = elem;
        arr->size = size;
        return arr;
    }
    if (at(P_LPAREN)) {
        Loc loc = next()->loc;
        TypeRef *fn = tref_new(TR_FUNC, loc);
        ParamList params = {0};
        parse_params(&params, &fn->params, &fn->variadic);
        if (fparams) *fparams = params;
        else free(params.items);
        fn->inner = suffixes(base, NULL);
        return fn;
    }
    return base;
}

static int nested_declarator_ahead(void) {
    if (!at(P_LPAREN)) return 0;
    TokKind k = peek_at(1)->kind;
    if (k == P_STAR || k == P_LPAREN) return 1;
    if (k == T_IDENT && !is_type_start_at(1) && peek_at(2)->kind == P_RPAREN) return 1;
    return 0;
}

TypeRef *parse_declarator(TypeRef *base, char **name, ParamList *fparams, Loc *nameloc) {
    while (at(P_STAR)) {
        Loc loc = next()->loc;
        TypeRef *p = tref_new(TR_PTR, loc);
        p->inner = base;
        while (quals_of(peek()->kind)) p->quals |= quals_of(next()->kind);
        base = p;
    }
    if (nested_declarator_ahead()) {
        next();
        TypeRef *hole = tref_new(TR_NAME, peek()->loc);
        hole->name = xstrdup("__hole");
        ParamList inner_params = {0};
        TypeRef *inner = parse_declarator(hole, name, &inner_params, nameloc);
        expect(P_RPAREN, "')'");
        TypeRef *outer = suffixes(base, inner_params.len || !fparams ? NULL : fparams);
        if (fparams && inner_params.len) *fparams = inner_params;
        *hole = *outer;
        return inner;
    }
    if (at(T_IDENT) && name) {
        Token *t = next();
        *name = xstrdup(t->text);
        if (nameloc) *nameloc = t->loc;
    }
    return suffixes(base, fparams);
}

TypeRef *parse_type_name(void) {
    Specs sp;
    if (!parse_specifiers(&sp)) fail(peek()->loc, "expected a type");
    return parse_declarator(sp.base, NULL, NULL, NULL);
}

Node *parse_struct_body(Node *s) {
    expect(P_LBRACE, "'{'");
    s->flags |= F_BODY;
    while (!at(P_RBRACE)) {
        if (at(T_DIRECTIVE)) {
            Node *d = node_new(N_DIRECTIVE, peek()->loc);
            d->text = xstrdup(next()->text);
            vec_push(s->list, d);
            continue;
        }
        if (accept(P_SEMI)) continue;
        Specs sp;
        Loc loc = peek()->loc;
        if (!parse_specifiers(&sp)) fail(loc, "expected a field declaration");
        if (at(P_SEMI)) {
            /* anonymous struct/union member */
            Node *f = node_new(N_FIELD, loc);
            f->tref = sp.base;
            vec_push(s->list, f);
            next();
            continue;
        }
        for (;;) {
            Node *f = node_new(N_FIELD, loc);
            char *name = NULL;
            f->tref = parse_declarator(sp.base, &name, NULL, &f->loc);
            f->name = name;
            f->flags |= sp.storage & F_WEAK;
            if (accept(P_COLON)) f->a = parse_ternary();
            vec_push(s->list, f);
            if (!accept(P_COMMA)) break;
        }
        expect(P_SEMI, "';'");
    }
    expect(P_RBRACE, "'}'");
    return s;
}

Node *parse_cenum_body(Node *e) {
    expect(P_LBRACE, "'{'");
    e->flags |= F_BODY;
    while (!at(P_RBRACE)) {
        Token *n = expect(T_IDENT, "an enumerator name");
        Node *en = node_new(N_ENUMERATOR, n->loc);
        en->name = xstrdup(n->text);
        if (accept(P_ASSIGN)) en->a = parse_ternary();
        vec_push(e->list, en);
        if (!accept(P_COMMA)) break;
    }
    expect(P_RBRACE, "'}'");
    return e;
}

/* `enum Name { A, B(int x) }` without a trailing ';' or '=' values */
int moxy_enum_ahead(void) {
    if (!at(K_ENUM) || peek_at(1)->kind != T_IDENT || peek_at(2)->kind != P_LBRACE) return 0;
    int open = P.pos + 2;
    int close = match_paren(open);
    if (close < 0) return 0;
    int depth = 0;
    for (int i = open + 1; i < close; i++) {
        TokKind k = P.toks[i].kind;
        if (k == P_LPAREN) {
            if (depth == 0) return 1;
            depth++;
        }
        if (k == P_RPAREN) depth--;
        if (k == P_ASSIGN && depth == 0) return 0;
    }
    TokKind after = P.toks[close + 1].kind;
    return after != P_SEMI && after != T_IDENT && after != P_STAR;
}

Node *parse_moxy_enum(void) {
    Token *kw = next();
    Token *name = expect(T_IDENT, "an enum name");
    Node *e = node_new(N_ENUM, kw->loc);
    e->name = xstrdup(name->text);
    expect(P_LBRACE, "'{'");
    while (!at(P_RBRACE)) {
        Token *vn = expect(T_IDENT, "a variant name");
        Node *v = node_new(N_VARIANT, vn->loc);
        v->name = xstrdup(vn->text);
        if (accept(P_LPAREN)) {
            int idx = 0;
            while (!at(P_RPAREN)) {
                Loc loc = peek()->loc;
                TypeRef *t = parse_type_name();
                char *fname = NULL;
                Loc floc = loc;
                if (at(T_IDENT)) {
                    floc = peek()->loc;
                    fname = xstrdup(next()->text);
                } else {
                    fname = xfmt("_%d", idx);
                }
                Param p = {fname, t, floc, NULL};
                vec_push(v->params, p);
                idx++;
                if (!accept(P_COMMA)) break;
            }
            expect(P_RPAREN, "')'");
        }
        vec_push(e->list, v);
        if (!accept(P_COMMA)) break;
    }
    expect(P_RBRACE, "'}'");
    accept(P_SEMI);
    return e;
}
