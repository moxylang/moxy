    "#define MXY_FMT_ANY(b, x) _Generic((x),                          \\\n"
    "    _Bool: mxy_fmtv_bool, char: mxy_fmtv_char,                    \\\n"
    "    signed char: mxy_fmtv_schar, unsigned char: mxy_fmtv_uchar,   \\\n"
    "    short: mxy_fmtv_short, unsigned short: mxy_fmtv_ushort,       \\\n"
    "    int: mxy_fmtv_int, unsigned int: mxy_fmtv_uint,               \\\n"
    "    long: mxy_fmtv_long, unsigned long: mxy_fmtv_ulong,           \\\n"
    "    long long: mxy_fmtv_llong, unsigned long long: mxy_fmtv_ullong, \\\n"
    "    float: mxy_fmtv_float, double: mxy_fmtv_double,               \\\n"
    "    long double: mxy_fmtv_ldouble, char *: mxy_fmtv_cstr,          \\\n"
    "    const char *: mxy_fmtv_cstr, default: mxy_fmtv_ptr)(b, x)\n"
    "\n"
    "MXY_FN void mxy_buf_flush(mxy_buf *b, FILE *f) {\n"
    "    if (b->len) fwrite(b->data, 1, (size_t)b->len, f);\n"
    "    free(b->data);\n"
    "    b->data = NULL;\n"
    "    b->len = b->cap = 0;\n"
    "}\n"
    "\n"
    "#define MXY_PRIM_VW(NAME, T, FMTEXPR)                                                     \\\n"
    "    MXY_FN bool mxy_eq_##NAME(const void *a, const void *b) { return *(const T *)a == *(const T *)b; } \\\n"
    "    MXY_FN uint64_t mxy_hash_##NAME(const void *p) { return mxy_hash_u64((uint64_t) * (const T *)p); } \\\n"
    "    MXY_FN int mxy_cmp_##NAME(const void *a, const void *b) {                              \\\n"
    "        T x = *(const T *)a, y = *(const T *)b;                                             \\\n"
    "        return (x > y) - (x < y);                                                          \\\n"
    "    }                                                                                      \\\n"
    "    MXY_FN void mxy_fmtp_##NAME(mxy_buf *b, const void *p, int nested) {                   \\\n"
    "        (void)nested;                                                                      \\\n"
    "        T v = *(const T *)p;                                                               \\\n"
    "        FMTEXPR;                                                                           \\\n"
    "    }                                                                                      \\\n"
    "    static const mxy_vw mxy_vw_##NAME __attribute__((unused)) = {                          \\\n"
    "        sizeof(T), NULL, NULL, mxy_eq_##NAME, mxy_hash_##NAME, mxy_cmp_##NAME, mxy_fmtp_##NAME, #NAME};\n"
    "\n"
    "MXY_PRIM_VW(bool, bool, mxy_fmtv_bool(b, v))\n"
    "MXY_PRIM_VW(char, char, if (nested) mxy_fmt_quoted(b, &v, 1, '\\''); else mxy_buf_putc(b, v))\n"
    "MXY_PRIM_VW(schar, signed char, mxy_fmtv_schar(b, v))\n"
    "MXY_PRIM_VW(uchar, unsigned char, mxy_fmtv_uchar(b, v))\n"
    "MXY_PRIM_VW(short, short, mxy_fmtv_short(b, v))\n"
    "MXY_PRIM_VW(ushort, unsigned short, mxy_fmtv_ushort(b, v))\n"
    "MXY_PRIM_VW(int, int, mxy_fmtv_int(b, v))\n"
    "MXY_PRIM_VW(uint, unsigned int, mxy_fmtv_uint(b, v))\n"
    "MXY_PRIM_VW(long, long, mxy_fmtv_long(b, v))\n"
    "MXY_PRIM_VW(ulong, unsigned long, mxy_fmtv_ulong(b, v))\n"
    "MXY_PRIM_VW(llong, long long, mxy_fmtv_llong(b, v))\n"
    "MXY_PRIM_VW(ullong, unsigned long long, mxy_fmtv_ullong(b, v))\n"
    "MXY_PRIM_VW(float, float, mxy_fmtv_float(b, v))\n"
    "MXY_PRIM_VW(double, double, mxy_fmtv_double(b, v))\n"
    "MXY_PRIM_VW(ldouble, long double, mxy_fmtv_ldouble(b, v))\n"
    "\n"
    "MXY_FN bool mxy_eq_ptr(const void *a, const void *b) { return *(void *const *)a == *(void *const *)b; }\n"
    "MXY_FN uint64_t mxy_hash_ptr(const void *p) { return mxy_hash_u64((uint64_t)(uintptr_t) * (void *const *)p); }\n"
    "MXY_FN int mxy_cmp_ptr(const void *a, const void *b) {\n"
    "    uintptr_t x = (uintptr_t) * (void *const *)a, y = (uintptr_t) * (void *const *)b;\n"
    "    return (x > y) - (x < y);\n"
    "}\n"
    "MXY_FN void mxy_fmtp_ptr(mxy_buf *b, const void *p, int nested) {\n"
    "    (void)nested;\n"
    "    mxy_fmtv_ptr(b, *(void *const *)p);\n"
    "}\n"
    "static const mxy_vw mxy_vw_ptr __attribute__((unused)) = {sizeof(void *), NULL, NULL, mxy_eq_ptr, mxy_hash_ptr, mxy_cmp_ptr, mxy_fmtp_ptr, \"pointer\"};\n"
    "\n"
    "MXY_FN void mxy_copy_str(void *dst, const void *src) { *(mxy_str *)dst = mxy_str_retain(*(const mxy_str *)src); }\n"
    "MXY_FN void mxy_drop_str(void *p) { mxy_str_release(*(mxy_str *)p); }\n"
    "MXY_FN bool mxy_eq_str(const void *a, const void *b) { return mxy_str_eq(*(const mxy_str *)a, *(const mxy_str *)b); }\n"
    "MXY_FN uint64_t mxy_hash_str(const void *p) {\n"
    "    mxy_str s = *(const mxy_str *)p;\n"
    "    return mxy_hash_bytes(s ? s : \"\", (size_t)mxy_str_len(s));\n"
    "}\n"
    "MXY_FN int mxy_cmp_str(const void *a, const void *b) { return mxy_str_cmp(*(const mxy_str *)a, *(const mxy_str *)b); }\n"
    "MXY_FN void mxy_fmtp_str(mxy_buf *b, const void *p, int nested) {\n"
    "    mxy_str s = *(const mxy_str *)p;\n"
    "    if (nested && s) mxy_fmt_quoted(b, s, mxy_str_len(s), '\"');\n"
    "    else mxy_fmtv_str(b, s);\n"
    "}\n"
    "static const mxy_vw mxy_vw_str __attribute__((unused)) = {sizeof(mxy_str), mxy_copy_str, mxy_drop_str, mxy_eq_str, mxy_hash_str, mxy_cmp_str, mxy_fmtp_str, \"string\"};\n"
    "\n"
    "MXY_FN mxy_str mxy_str_of(const mxy_vw *vw, const void *p) {\n"
    "    mxy_buf b = {0};\n"
    "    mxy_vw_fmt(vw, &b, p, 0);\n"
    "    return mxy_str_from_buf(&b);\n"
    "}\n"
    "/* moxy runtime: lists (copy-on-write, reference counted; NULL is the empty list) */\n"
    "typedef struct mxy_list {\n"
    "    int64_t rc;\n"
    "    int64_t len;\n"
    "    int64_t cap;\n"
    "    const mxy_vw *vw;\n"
    "    char *data;\n"
    "} mxy_list;\n"
    "\n"
    "#define MXY_AT(l, i) ((l)->data + (size_t)(i) * (l)->vw->size)\n"
    "\n"
    "MXY_FN mxy_list *mxy_list_new(const mxy_vw *vw, int64_t cap) {\n"
    "    mxy_list *l = (mxy_list *)mxy_alloc(sizeof(mxy_list));\n"
    "    l->rc = 1;\n"
    "    l->len = 0;\n"
    "    l->cap = cap < 4 ? 4 : cap;\n"
    "    l->vw = vw;\n"
    "    l->data = (char *)mxy_alloc((size_t)l->cap * vw->size);\n"
    "    return l;\n"
    "}\n"
    "\n"
    "MXY_INLINE mxy_list *mxy_list_retain(mxy_list *l) {\n"
    "    if (l) mxy_rc_inc(&l->rc);\n"
    "    return l;\n"
    "}\n"
    "\n"
    "MXY_FN void mxy_list_release(mxy_list *l) {\n"
    "    if (!l || !mxy_rc_dec(&l->rc)) return;\n"
    "    if (l->vw->drop)\n"
    "        for (int64_t i = 0; i < l->len; i++) l->vw->drop(MXY_AT(l, i));\n"
    "    free(l->data);\n"
    "    free(l);\n"
    "}\n"
    "\n"
    "MXY_INLINE int64_t mxy_list_len(const mxy_list *l) { return l ? l->len : 0; }\n"
    "\n"
    "/* takes ownership of n elements at `elems` */\n"
    "MXY_FN mxy_list *mxy_list_from(const mxy_vw *vw, int64_t n, const void *elems) {\n"
    "    mxy_list *l = mxy_list_new(vw, n);\n"
    "    if (n) memcpy(l->data, elems, (size_t)n * vw->size);\n"
    "    l->len = n;\n"
    "    return l;\n"
    "}\n"
    "\n"
    "MXY_FN mxy_list *mxy_list_clone(const mxy_list *src, const mxy_vw *vw, int64_t cap) {\n"
    "    mxy_list *l = mxy_list_new(vw, cap);\n"
    "    int64_t n = mxy_list_len(src);\n"
    "    for (int64_t i = 0; i < n; i++) mxy_vw_copy(vw, MXY_AT(l, i), MXY_AT(src, i));\n"
    "    l->len = n;\n"
    "    return l;\n"
    "}\n"
    "\n"
    "/* make *lp uniquely owned before mutation */\n"
    "MXY_FN void mxy_list_unique(mxy_list **lp, const mxy_vw *vw) {\n"
    "    mxy_list *l = *lp;\n"
    "    if (!l) {\n"
    "        *lp = mxy_list_new(vw, 4);\n"
    "        return;\n"
    "    }\n"
    "    if (l->rc == 1 || l->rc < 0) return;\n"
    "    mxy_list *c = mxy_list_clone(l, l->vw, l->cap);\n"
    "    mxy_list_release(l);\n"
    "    *lp = c;\n"
    "}\n"
    "\n"
    "MXY_FN void mxy_list_reserve(mxy_list *l, int64_t n) {\n"
    "    if (n <= l->cap) return;\n"
    "    int64_t cap = l->cap * 2;\n"
    "    if (cap < n) cap = n;\n"
    "    l->data = (char *)mxy_realloc(l->data, (size_t)cap * l->vw->size);\n"
    "    l->cap = cap;\n"
    "}\n"
    "\n"
    "MXY_FN void mxy_list_push(mxy_list **lp, const mxy_vw *vw, const void *elem, int move) {\n"
    "    mxy_list_unique(lp, vw);\n"
    "    mxy_list *l = *lp;\n"
    "    mxy_list_reserve(l, l->len + 1);\n"
    "    if (move) memcpy(MXY_AT(l, l->len), elem, vw->size);\n"
    "    else mxy_vw_copy(vw, MXY_AT(l, l->len), elem);\n"
    "    l->len++;\n"
    "}\n"
    "\n"
    "MXY_FN MXY_NORETURN void mxy_list_oob(int64_t i, int64_t n, const char *loc) {\n"
    "    mxy_panic(loc, \"index %lld out of range for list of length %lld\", (long long)i, (long long)n);\n"
    "}\n"
    "\n"
    "MXY_INLINE void *mxy_list_at(const mxy_list *l, int64_t i, const char *loc) {\n"
    "    int64_t n = mxy_list_len(l);\n"
    "    if (i < 0 || i >= n) mxy_list_oob(i, n, loc);\n"
    "    return MXY_AT(l, i);\n"
    "}\n"
    "\n"
    "MXY_FN void *mxy_list_at_mut(mxy_list **lp, const mxy_vw *vw, int64_t i, const char *loc) {\n"
    "    int64_t n = mxy_list_len(*lp);\n"
    "    if (i < 0 || i >= n) mxy_list_oob(i, n, loc);\n"
    "    mxy_list_unique(lp, vw);\n"
    "    return MXY_AT(*lp, i);\n"
    "}\n"
    "\n"
    "MXY_FN void mxy_list_set(mxy_list **lp, const mxy_vw *vw, int64_t i, const void *val, int move, const char *loc) {\n"
    "    void *slot = mxy_list_at_mut(lp, vw, i, loc);\n"
    "    char old[vw->size > 0 ? vw->size : 1];\n"
    "    memcpy(old, slot, vw->size);\n"
    "    if (move) memcpy(slot, val, vw->size);\n"
    "    else mxy_vw_copy(vw, slot, val);\n"
    "    mxy_vw_drop(vw, old);\n"
    "}\n"
    "\n"
    "MXY_FN void mxy_list_pop(mxy_list **lp, const mxy_vw *vw, void *out, const char *loc) {\n"
    "    if (!mxy_list_len(*lp)) mxy_panic(loc, \"pop from an empty list\");\n"
    "    mxy_list_unique(lp, vw);\n"
    "    mxy_list *l = *lp;\n"
    "    l->len--;\n"
    "    memcpy(out, MXY_AT(l, l->len), vw->size);\n"
    "}\n"
    "\n"
    "MXY_FN void mxy_list_insert(mxy_list **lp, const mxy_vw *vw, int64_t i, const void *val, int move, const char *loc) {\n"
    "    int64_t n = mxy_list_len(*lp);\n"
    "    if (i < 0 || i > n) mxy_list_oob(i, n, loc);\n"
    "    mxy_list_unique(lp, vw);\n"
    "    mxy_list *l = *lp;\n"
    "    mxy_list_reserve(l, l->len + 1);\n"
    "    memmove(MXY_AT(l, i + 1), MXY_AT(l, i), (size_t)(l->len - i) * vw->size);\n"
    "    if (move) memcpy(MXY_AT(l, i), val, vw->size);\n"
    "    else mxy_vw_copy(vw, MXY_AT(l, i), val);\n"
    "    l->len++;\n"
    "}\n"
    "\n"
    "MXY_FN void mxy_list_remove(mxy_list **lp, const mxy_vw *vw, int64_t i, void *out, const char *loc) {\n"
    "    int64_t n = mxy_list_len(*lp);\n"
    "    if (i < 0 || i >= n) mxy_list_oob(i, n, loc);\n"
    "    mxy_list_unique(lp, vw);\n"
    "    mxy_list *l = *lp;\n"
    "    memcpy(out, MXY_AT(l, i), vw->size);\n"
    "    memmove(MXY_AT(l, i), MXY_AT(l, i + 1), (size_t)(l->len - i - 1) * vw->size);\n"
    "    l->len--;\n"
    "}\n"
    "\n"
    "MXY_FN void mxy_list_clear(mxy_list **lp) {\n"
    "    mxy_list_release(*lp);\n"
    "    *lp = NULL;\n"
    "}\n"
    "\n"
    "MXY_FN int64_t mxy_list_index_of(const mxy_list *l, const mxy_vw *vw, const void *x) {\n"
    "    for (int64_t i = 0; i < mxy_list_len(l); i++)\n"
    "        if (mxy_vw_eq(vw, MXY_AT(l, i), x)) return i;\n"
    "    return -1;\n"
    "}\n"
    "\n"
    "MXY_FN mxy_list *mxy_list_slice(const mxy_list *l, const mxy_vw *vw, int64_t a, int64_t b, const char *loc) {\n"
    "    int64_t n = mxy_list_len(l);\n"
    "    if (a < 0 || b < a || b > n)\n"
    "        mxy_panic(loc, \"slice [%lld, %lld) out of range for list of length %lld\", (long long)a, (long long)b, (long long)n);\n"
    "    mxy_list *r = mxy_list_new(vw, b - a);\n"
    "    for (int64_t i = a; i < b; i++) mxy_vw_copy(vw, MXY_AT(r, i - a), MXY_AT(l, i));\n"
    "    r->len = b - a;\n"
    "    return r;\n"
    "}\n"
    "\n"
    "MXY_FN mxy_list *mxy_list_concat(const mxy_list *a, const mxy_list *b, const mxy_vw *vw) {\n"
    "    mxy_list *r = mxy_list_clone(a, vw, mxy_list_len(a) + mxy_list_len(b));\n"
    "    for (int64_t i = 0; i < mxy_list_len(b); i++) mxy_vw_copy(vw, MXY_AT(r, r->len++), MXY_AT(b, i));\n"
    "    return r;\n"
    "}\n"
    "\n"
    "MXY_FN void mxy_list_reverse(mxy_list **lp, const mxy_vw *vw) {\n"
    "    if (mxy_list_len(*lp) < 2) return;\n"
    "    mxy_list_unique(lp, vw);\n"
    "    mxy_list *l = *lp;\n"
    "    char tmp[vw->size];\n"
    "    for (int64_t i = 0, j = l->len - 1; i < j; i++, j--) {\n"
    "        memcpy(tmp, MXY_AT(l, i), vw->size);\n"
    "        memcpy(MXY_AT(l, i), MXY_AT(l, j), vw->size);\n"
    "        memcpy(MXY_AT(l, j), tmp, vw->size);\n"
    "    }\n"
    "}\n"
    "\n"
    "MXY_FN void mxy_merge_sort(char *a, char *tmp, int64_t n, const mxy_vw *vw) {\n"
    "    if (n < 2) return;\n"
    "    int64_t mid = n / 2;\n"
    "    size_t sz = vw->size;\n"
    "    mxy_merge_sort(a, tmp, mid, vw);\n"
    "    mxy_merge_sort(a + (size_t)mid * sz, tmp, n - mid, vw);\n"
    "    int64_t i = 0, j = mid, k = 0;\n"
    "    while (i < mid && j < n) {\n"
    "        if (vw->cmp(a + (size_t)j * sz, a + (size_t)i * sz) < 0) memcpy(tmp + (size_t)k++ * sz, a + (size_t)j++ * sz, sz);\n"
    "        else memcpy(tmp + (size_t)k++ * sz, a + (size_t)i++ * sz, sz);\n"
    "    }\n"
    "    while (i < mid) memcpy(tmp + (size_t)k++ * sz, a + (size_t)i++ * sz, sz);\n"
    "    while (j < n) memcpy(tmp + (size_t)k++ * sz, a + (size_t)j++ * sz, sz);\n"
    "    memcpy(a, tmp, (size_t)n * sz);\n"
    "}\n"
    "\n"
    "MXY_FN void mxy_list_sort(mxy_list **lp, const mxy_vw *vw) {\n"
    "    if (mxy_list_len(*lp) < 2) return;\n"
    "    if (!vw->cmp) mxy_panic(NULL, \"values of type %s cannot be sorted\", vw->name);\n"
    "    mxy_list_unique(lp, vw);\n"
    "    mxy_list *l = *lp;\n"
    "    char *tmp = (char *)mxy_alloc((size_t)l->len * vw->size);\n"
    "    mxy_merge_sort(l->data, tmp, l->len, vw);\n"
    "    free(tmp);\n"
    "}\n"
    "\n"
    "MXY_FN bool mxy_list_eq(const mxy_list *a, const mxy_list *b) {\n"
    "    int64_t n = mxy_list_len(a);\n"
    "    if (n != mxy_list_len(b)) return false;\n"
    "    for (int64_t i = 0; i < n; i++)\n"
    "        if (!mxy_vw_eq(a->vw, MXY_AT(a, i), MXY_AT(b, i))) return false;\n"
    "    return true;\n"
    "}\n"
    "\n"
    "MXY_FN void mxy_list_fmt(mxy_buf *b, const mxy_list *l) {\n"
    "    mxy_buf_putc(b, '[');\n"
    "    for (int64_t i = 0; i < mxy_list_len(l); i++) {\n"
    "        if (i) mxy_buf_puts(b, \", \");\n"
    "        mxy_vw_fmt(l->vw, b, MXY_AT(l, i), 1);\n"
    "    }\n"
    "    mxy_buf_putc(b, ']');\n"
    "}\n"
    "\n"
    "MXY_FN mxy_str mxy_list_join(const mxy_list *l, mxy_str sep) {\n"
    "    mxy_buf b = {0};\n"
    "    for (int64_t i = 0; i < mxy_list_len(l); i++) {\n"
    "        if (i && sep) mxy_buf_put(&b, sep, mxy_str_len(sep));\n"
    "        mxy_vw_fmt(l->vw, &b, MXY_AT(l, i), 0);\n"
    "    }\n"
    "    return mxy_str_from_buf(&b);\n"
    "}\n"
    "\n"
    "MXY_FN void mxy_copy_list(void *dst, const void *src) { *(mxy_list **)dst = mxy_list_retain(*(mxy_list *const *)src); }\n"
    "MXY_FN void mxy_drop_list(void *p) { mxy_list_release(*(mxy_list **)p); }\n"
    "MXY_FN bool mxy_eq_list(const void *a, const void *b) { return mxy_list_eq(*(mxy_list *const *)a, *(mxy_list *const *)b); }\n"
    "MXY_FN uint64_t mxy_hash_list(const void *p) {\n"
    "    const mxy_list *l = *(mxy_list *const *)p;\n"
    "    uint64_t h = 7;\n"
    "    for (int64_t i = 0; i < mxy_list_len(l); i++) h = h * 31 + mxy_vw_hash(l->vw, MXY_AT(l, i));\n"
    "    return h;\n"
    "}\n"
    "MXY_FN void mxy_fmtp_list(mxy_buf *b, const void *p, int nested) {\n"
    "    (void)nested;\n"
    "    mxy_list_fmt(b, *(mxy_list *const *)p);\n"
    "}\n"
    "static const mxy_vw mxy_vw_list __attribute__((unused)) = {sizeof(mxy_list *), mxy_copy_list, mxy_drop_list, mxy_eq_list, mxy_hash_list, NULL, mxy_fmtp_list, \"list\"};\n"
    "\n"
    "MXY_FN mxy_list *mxy_str_split(mxy_str s, mxy_str sep) {\n"
    "    mxy_list *out = mxy_list_new(&mxy_vw_str, 4);\n"
    "    int64_t n = mxy_str_len(s), m = mxy_str_len(sep);\n"
    "    int64_t start = 0;\n"
    "    if (m == 0) {\n"
    "        for (int64_t i = 0; i < n; i++) {\n"
    "            mxy_str c = mxy_str_fromn(s + i, 1);\n"
    "            mxy_list_push(&out, &mxy_vw_str, &c, 1);\n"
    "        }\n"
    "        return out;\n"
    "    }\n"
    "    for (int64_t i = 0; i + m <= n;) {\n"
    "        if (memcmp(s + i, sep, (size_t)m) == 0) {\n"
    "            mxy_str part = mxy_str_fromn(s + start, i - start);\n"
    "            mxy_list_push(&out, &mxy_vw_str, &part, 1);\n"
    "            i += m;\n"
    "            start = i;\n"
    "        } else {\n"
    "            i++;\n"
    "        }\n"
    "    }\n"
    "    mxy_str last = mxy_str_fromn(s ? s + start : \"\", n - start);\n"
    "    mxy_list_push(&out, &mxy_vw_str, &last, 1);\n"
    "    return out;\n"
    "}\n"
    "\n"
    "MXY_FN mxy_list *mxy_str_lines(mxy_str s) {\n"
    "    mxy_list *out = mxy_list_new(&mxy_vw_str, 4);\n"
    "    int64_t n = mxy_str_len(s), start = 0;\n"
    "    for (int64_t i = 0; i < n; i++) {\n"
    "        if (s[i] != '\\n') continue;\n"
    "        int64_t end = i > start && s[i - 1] == '\\r' ? i - 1 : i;\n"
    "        mxy_str part = mxy_str_fromn(s + start, end - start);\n"
    "        mxy_list_push(&out, &mxy_vw_str, &part, 1);\n"
    "        start = i + 1;\n"
    "    }\n"
    "    if (start < n) {\n"
    "        mxy_str part = mxy_str_fromn(s + start, n - start);\n"
    "        mxy_list_push(&out, &mxy_vw_str, &part, 1);\n"
    "    }\n"
    "    return out;\n"
    "}\n"
    "\n"
    "MXY_FN mxy_list *mxy_str_chars(mxy_str s) {\n"
    "    int64_t n = mxy_str_len(s);\n"
    "    return mxy_list_from(&mxy_vw_char, n, s ? s : \"\");\n"
    "}\n"
    "/* moxy runtime: maps (insertion-ordered hash maps, copy-on-write; NULL is empty) */\n"
    "typedef struct {\n"
    "    uint64_t hash;\n"
    "    int64_t live;\n"
    "} mxy_entry;\n"
    "\n"
    "typedef struct mxy_map {\n"
    "    int64_t rc;\n"
    "    int64_t len;    /* live entries */\n"
    "    int64_t count;  /* used entry slots (live + removed) */\n"
    "    int64_t cap;    /* entry slots */\n"
    "    const mxy_vw *kvw;\n"
    "    const mxy_vw *vvw;\n"
    "    size_t koff;\n"
    "    size_t voff;\n"
    "    size_t esize;\n"
    "    char *entries;\n"
    "    int64_t *index; /* -1 empty, -2 removed, otherwise entry slot */\n"
    "    int64_t icap;\n"
    "} mxy_map;\n"
    "\n"
    "#define MXY_ALIGN8(n) (((n) + 7) & ~(size_t)7)\n"
    "#define MXY_ENTRY(m, i) ((mxy_entry *)((m)->entries + (size_t)(i) * (m)->esize))\n"
    "#define MXY_KEY(m, i) ((void *)((m)->entries + (size_t)(i) * (m)->esize + (m)->koff))\n"
    "#define MXY_VAL(m, i) ((void *)((m)->entries + (size_t)(i) * (m)->esize + (m)->voff))\n"
    "\n"
    "MXY_FN mxy_map *mxy_map_new(const mxy_vw *kvw, const mxy_vw *vvw, int64_t cap) {\n"
    "    mxy_map *m = (mxy_map *)mxy_zalloc(sizeof(mxy_map));\n"
    "    m->rc = 1;\n"
    "    m->kvw = kvw;\n"
    "    m->vvw = vvw;\n"
    "    m->koff = sizeof(mxy_entry);\n"
    "    m->voff = m->koff + MXY_ALIGN8(kvw->size);\n"
    "    m->esize = m->voff + MXY_ALIGN8(vvw->size);\n"
    "    m->cap = cap < 8 ? 8 : cap;\n"
    "    m->entries = (char *)mxy_alloc((size_t)m->cap * m->esize);\n"
    "    m->icap = 16;\n"
    "    while (m->icap < m->cap * 2) m->icap *= 2;\n"
    "    m->index = (int64_t *)mxy_alloc((size_t)m->icap * sizeof(int64_t));\n"
    "    for (int64_t i = 0; i < m->icap; i++) m->index[i] = -1;\n"
    "    return m;\n"
    "}\n"
    "\n"
    "MXY_INLINE mxy_map *mxy_map_retain(mxy_map *m) {\n"
    "    if (m) mxy_rc_inc(&m->rc);\n"
    "    return m;\n"
    "}\n"
    "\n"
    "MXY_FN void mxy_map_release(mxy_map *m) {\n"
    "    if (!m || !mxy_rc_dec(&m->rc)) return;\n"
    "    for (int64_t i = 0; i < m->count; i++) {\n"
    "        if (!MXY_ENTRY(m, i)->live) continue;\n"
    "        mxy_vw_drop(m->kvw, MXY_KEY(m, i));\n"
    "        mxy_vw_drop(m->vvw, MXY_VAL(m, i));\n"
    "    }\n"
    "    free(m->entries);\n"
    "    free(m->index);\n"
    "    free(m);\n"
    "}\n"
    "\n"
    "MXY_INLINE int64_t mxy_map_len(const mxy_map *m) { return m ? m->len : 0; }\n"
    "\n"
    "MXY_FN int64_t mxy_map_find(const mxy_map *m, const void *key, uint64_t h) {\n"
    "    if (!m) return -1;\n"
    "    int64_t mask = m->icap - 1;\n"
    "    for (int64_t i = (int64_t)(h & (uint64_t)mask);; i = (i + 1) & mask) {\n"
    "        int64_t slot = m->index[i];\n"
    "        if (slot == -1) return -1;\n"
    "        if (slot >= 0 && MXY_ENTRY(m, slot)->hash == h && mxy_vw_eq(m->kvw, MXY_KEY(m, slot), key)) return slot;\n"
    "    }\n"
    "}\n"
    "\n"
    "MXY_FN void mxy_map_reindex(mxy_map *m, int64_t icap) {\n"
    "    free(m->index);\n"
    "    m->icap = icap;\n"
    "    m->index = (int64_t *)mxy_alloc((size_t)icap * sizeof(int64_t));\n"
    "    for (int64_t i = 0; i < icap; i++) m->index[i] = -1;\n"
    "    for (int64_t s = 0; s < m->count; s++) {\n"
    "        if (!MXY_ENTRY(m, s)->live) continue;\n"
    "        int64_t i = (int64_t)(MXY_ENTRY(m, s)->hash & (uint64_t)(icap - 1));\n"
    "        while (m->index[i] != -1) i = (i + 1) & (icap - 1);\n"
    "        m->index[i] = s;\n"
    "    }\n"
    "}\n"
    "\n"
    "/* drop removed slots and grow so one more entry fits */\n"
    "MXY_FN void mxy_map_grow(mxy_map *m) {\n"
    "    if (m->count < m->cap) return;\n"
    "    int64_t w = 0;\n"
    "    for (int64_t s = 0; s < m->count; s++) {\n"
    "        if (!MXY_ENTRY(m, s)->live) continue;\n"
    "        if (w != s) memcpy(m->entries + (size_t)w * m->esize, m->entries + (size_t)s * m->esize, m->esize);\n"
    "        w++;\n"
    "    }\n"
    "    m->count = w;\n"
    "    if (m->count * 2 >= m->cap) {\n"
    "        m->cap *= 2;\n"
    "        m->entries = (char *)mxy_realloc(m->entries, (size_t)m->cap * m->esize);\n"
    "    }\n"
    "    int64_t icap = m->icap;\n"
    "    while (icap < m->cap * 2) icap *= 2;\n"
    "    mxy_map_reindex(m, icap);\n"
    "}\n"
    "\n"
    "MXY_FN mxy_map *mxy_map_clone(const mxy_map *src) {\n"
    "    mxy_map *m = mxy_map_new(src->kvw, src->vvw, src->len);\n"
    "    for (int64_t s = 0; s < src->count; s++) {\n"
    "        if (!MXY_ENTRY(src, s)->live) continue;\n"
    "        int64_t d = m->count++;\n"
    "        *MXY_ENTRY(m, d) = *MXY_ENTRY(src, s);\n"
    "        mxy_vw_copy(m->kvw, MXY_KEY(m, d), MXY_KEY(src, s));\n"
    "        mxy_vw_copy(m->vvw, MXY_VAL(m, d), MXY_VAL(src, s));\n"
    "        m->len++;\n"
    "    }\n"
    "    mxy_map_reindex(m, m->icap);\n"
    "    return m;\n"
    "}\n"
    "\n"
    "MXY_FN void mxy_map_unique(mxy_map **mp, const mxy_vw *kvw, const mxy_vw *vvw) {\n"
    "    if (!*mp) {\n"
    "        *mp = mxy_map_new(kvw, vvw, 8);\n"
    "        return;\n"
    "    }\n"
    "    if (mxy_rc_load(&(*mp)->rc) == 1) return;\n"
    "    mxy_map *c = mxy_map_clone(*mp);\n"
    "    mxy_map_release(*mp);\n"
    "    *mp = c;\n"
    "}\n"
    "\n"
    "MXY_FN void mxy_map_set(mxy_map **mp, const mxy_vw *kvw, const mxy_vw *vvw, const void *key, const void *val,\n"
    "                        int kmove, int vmove) {\n"
    "    mxy_map_unique(mp, kvw, vvw);\n"
    "    mxy_map *m = *mp;\n"
    "    uint64_t h = mxy_vw_hash(kvw, key);\n"
    "    int64_t slot = mxy_map_find(m, key, h);\n"
    "    if (slot >= 0) {\n"
    "        if (kmove) mxy_vw_drop(kvw, (void *)key);\n"
    "        mxy_vw_drop(vvw, MXY_VAL(m, slot));\n"
    "        if (vmove) memcpy(MXY_VAL(m, slot), val, vvw->size);\n"
    "        else mxy_vw_copy(vvw, MXY_VAL(m, slot), val);\n"
    "        return;\n"
    "    }\n"
    "    mxy_map_grow(m);\n"
    "    slot = m->count++;\n"
    "    MXY_ENTRY(m, slot)->hash = h;\n"
    "    MXY_ENTRY(m, slot)->live = 1;\n"
    "    if (kmove) memcpy(MXY_KEY(m, slot), key, kvw->size);\n"
    "    else mxy_vw_copy(kvw, MXY_KEY(m, slot), key);\n"
    "    if (vmove) memcpy(MXY_VAL(m, slot), val, vvw->size);\n"
    "    else mxy_vw_copy(vvw, MXY_VAL(m, slot), val);\n"
    "    m->len++;\n"
    "    int64_t i = (int64_t)(h & (uint64_t)(m->icap - 1));\n"
    "    while (m->index[i] >= 0) i = (i + 1) & (m->icap - 1);\n"
    "    m->index[i] = slot;\n"
    "}\n"
    "\n"
    "MXY_FN void *mxy_map_get(const mxy_map *m, const mxy_vw *kvw, const void *key, const char *loc) {\n"
    "    int64_t slot = mxy_map_find(m, key, mxy_vw_hash(kvw, key));\n"
    "    if (slot < 0) {\n"
    "        mxy_buf b = {0};\n"
    "        mxy_vw_fmt(kvw, &b, key, 1);\n"
    "        mxy_panic(loc, \"key %s not found in map\", b.data ? b.data : \"\");\n"
    "    }\n"
    "    return MXY_VAL(m, slot);\n"
    "}\n"
    "\n"
    "MXY_FN void *mxy_map_lookup(const mxy_map *m, const mxy_vw *kvw, const void *key) {\n"
    "    int64_t slot = mxy_map_find(m, key, mxy_vw_hash(kvw, key));\n"
    "    return slot < 0 ? NULL : MXY_VAL(m, slot);\n"
    "}\n"
    "\n"
    "MXY_FN bool mxy_map_has(const mxy_map *m, const mxy_vw *kvw, const void *key) {\n"
    "    return mxy_map_find(m, key, mxy_vw_hash(kvw, key)) >= 0;\n"
    "}\n"
    "\n"
    "MXY_FN bool mxy_map_remove(mxy_map **mp, const mxy_vw *kvw, const mxy_vw *vvw, const void *key) {\n"
    "    if (!*mp || !mxy_map_has(*mp, kvw, key)) return false;\n"
    "    mxy_map_unique(mp, kvw, vvw);\n"
    "    mxy_map *m = *mp;\n"
    "    uint64_t h = mxy_vw_hash(kvw, key);\n"
    "    int64_t mask = m->icap - 1;\n"
    "    for (int64_t i = (int64_t)(h & (uint64_t)mask);; i = (i + 1) & mask) {\n"
    "        int64_t slot = m->index[i];\n"
    "        if (slot == -1) return false;\n"
    "        if (slot >= 0 && MXY_ENTRY(m, slot)->hash == h && mxy_vw_eq(kvw, MXY_KEY(m, slot), key)) {\n"
    "            mxy_vw_drop(kvw, MXY_KEY(m, slot));\n"
    "            mxy_vw_drop(vvw, MXY_VAL(m, slot));\n"
    "            MXY_ENTRY(m, slot)->live = 0;\n"
    "            m->index[i] = -2;\n"
    "            m->len--;\n"
    "            return true;\n"
    "        }\n"
    "    }\n"
    "}\n"
    "\n"
    "MXY_FN void mxy_map_clear(mxy_map **mp) {\n"
    "    mxy_map_release(*mp);\n"
    "    *mp = NULL;\n"
    "}\n"
    "\n"
    "MXY_FN mxy_list *mxy_map_keys(const mxy_map *m, const mxy_vw *kvw) {\n"
    "    mxy_list *l = mxy_list_new(kvw, mxy_map_len(m));\n"
    "    for (int64_t s = 0; m && s < m->count; s++)\n"
    "        if (MXY_ENTRY(m, s)->live) mxy_list_push(&l, kvw, MXY_KEY(m, s), 0);\n"
    "    return l;\n"
    "}\n"
    "\n"
    "MXY_FN mxy_list *mxy_map_values(const mxy_map *m, const mxy_vw *vvw) {\n"
    "    mxy_list *l = mxy_list_new(vvw, mxy_map_len(m));\n"
    "    for (int64_t s = 0; m && s < m->count; s++)\n"
    "        if (MXY_ENTRY(m, s)->live) mxy_list_push(&l, vvw, MXY_VAL(m, s), 0);\n"
    "    return l;\n"
    "}\n"
    "\n"
    "MXY_INLINE int64_t mxy_map_slots(const mxy_map *m) { return m ? m->count : 0; }\n"
    "MXY_INLINE bool mxy_map_live(const mxy_map *m, int64_t s) { return MXY_ENTRY(m, s)->live != 0; }\n"
    "\n"
    "MXY_FN bool mxy_map_eq(const mxy_map *a, const mxy_map *b) {\n"
    "    if (mxy_map_len(a) != mxy_map_len(b)) return false;\n"
    "    for (int64_t s = 0; a && s < a->count; s++) {\n"
    "        if (!MXY_ENTRY(a, s)->live) continue;\n"
    "        void *v = mxy_map_lookup(b, a->kvw, MXY_KEY(a, s));\n"
    "        if (!v || !mxy_vw_eq(a->vvw, MXY_VAL(a, s), v)) return false;\n"
    "    }\n"
    "    return true;\n"
    "}\n"
    "\n"
    "MXY_FN void mxy_map_fmt(mxy_buf *b, const mxy_map *m) {\n"
    "    mxy_buf_putc(b, '{');\n"
    "    int first = 1;\n"
    "    for (int64_t s = 0; m && s < m->count; s++) {\n"
    "        if (!MXY_ENTRY(m, s)->live) continue;\n"
    "        if (!first) mxy_buf_puts(b, \", \");\n"
    "        first = 0;\n"
    "        mxy_vw_fmt(m->kvw, b, MXY_KEY(m, s), 1);\n"
    "        mxy_buf_puts(b, \": \");\n"
    "        mxy_vw_fmt(m->vvw, b, MXY_VAL(m, s), 1);\n"
    "    }\n"
    "    mxy_buf_putc(b, '}');\n"
    "}\n"
    "\n"
    "MXY_FN void mxy_copy_map(void *dst, const void *src) { *(mxy_map **)dst = mxy_map_retain(*(mxy_map *const *)src); }\n"
    "MXY_FN void mxy_drop_map(void *p) { mxy_map_release(*(mxy_map **)p); }\n"
    "MXY_FN bool mxy_eq_map(const void *a, const void *b) { return mxy_map_eq(*(mxy_map *const *)a, *(mxy_map *const *)b); }\n"
    "MXY_FN void mxy_fmtp_map(mxy_buf *b, const void *p, int nested) {\n"
    "    (void)nested;\n"
    "    mxy_map_fmt(b, *(mxy_map *const *)p);\n"
    "}\n"
    "static const mxy_vw mxy_vw_map __attribute__((unused)) = {sizeof(mxy_map *), mxy_copy_map, mxy_drop_map, mxy_eq_map, NULL, NULL, mxy_fmtp_map, \"map\"};\n"
    "\n"
    "MXY_FN void *mxy_map_get_mut(mxy_map **mp, const mxy_vw *kvw, const mxy_vw *vvw, const void *key, const char *loc) {\n"
    "    if (!mxy_map_has(*mp, kvw, key)) mxy_map_get(*mp, kvw, key, loc);\n"
    "    mxy_map_unique(mp, kvw, vvw);\n"
    "    return mxy_map_get(*mp, kvw, key, loc);\n"
    "}\n"
    "/* moxy runtime: ref objects (shared, reference counted, with weak references)\n"
    "   strong counts live references; weak counts weak references plus one held\n"
    "   collectively by all strong references. Fields are dropped when the last\n"
    "   strong reference goes; memory is freed when the last weak one goes. */\n"
    "typedef struct mxy_obj {\n"
    "    int64_t strong;\n"
    "    int64_t weak;\n"
    "    void (*drop)(void *self);\n"
    "    void (*fmt)(mxy_buf *b, const void *self);\n"
    "    const char *name;\n"
    "} mxy_obj;\n"
    "\n"
    "MXY_FN void *mxy_obj_new(size_t size, void (*drop)(void *), void (*fmt)(mxy_buf *, const void *), const char *name) {\n"
    "    mxy_obj *o = (mxy_obj *)mxy_zalloc(size);\n"
    "    o->strong = 1;\n"
    "    o->weak = 1;\n"
    "    o->drop = drop;\n"
    "    o->fmt = fmt;\n"
    "    o->name = name;\n"
    "    return o;\n"
    "}\n"
    "\n"
    "MXY_INLINE void *mxy_obj_retain(void *p) {\n"
    "    if (p) mxy_rc_inc(&((mxy_obj *)p)->strong);\n"
    "    return p;\n"
    "}\n"
    "\n"
    "MXY_INLINE void *mxy_obj_weak_retain(void *p) {\n"
    "    if (p) mxy_rc_inc(&((mxy_obj *)p)->weak);\n"
    "    return p;\n"
    "}\n"
    "\n"
    "MXY_FN void mxy_obj_weak_release(void *p) {\n"
    "    if (p && mxy_rc_dec(&((mxy_obj *)p)->weak)) free(p);\n"
    "}\n"
    "\n"
    "MXY_FN void mxy_obj_release(void *p) {\n"
    "    mxy_obj *o = (mxy_obj *)p;\n"
    "    if (!o || !mxy_rc_dec(&o->strong)) return;\n"
    "    if (o->drop) o->drop(o);\n"
    "    mxy_obj_weak_release(o);\n"
    "}\n"
    "\n"
    "/* strong reference from a weak one, or NULL once the object is gone */\n"
    "MXY_FN void *mxy_obj_weak_load(void *p) {\n"
    "    mxy_obj *o = (mxy_obj *)p;\n"
    "    if (!o) return NULL;\n"
    "    int64_t s = __atomic_load_n(&o->strong, __ATOMIC_ACQUIRE);\n"
    "    while (s > 0)\n"
    "        if (__atomic_compare_exchange_n(&o->strong, &s, s + 1, 1, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) return o;\n"
    "    return NULL;\n"
    "}\n"
    "\n"
    "MXY_FN void mxy_copy_obj(void *dst, const void *src) { *(void **)dst = mxy_obj_retain(*(void *const *)src); }\n"
    "MXY_FN void mxy_drop_obj(void *p) { mxy_obj_release(*(void **)p); }\n"
    "MXY_FN void mxy_fmtp_obj(mxy_buf *b, const void *p, int nested) {\n"
    "    (void)nested;\n"
    "    const mxy_obj *o = *(mxy_obj *const *)p;\n"
    "    if (!o) mxy_buf_puts(b, \"null\");\n"
    "    else if (o->fmt) o->fmt(b, o);\n"
    "    else mxy_buf_printf(b, \"%s@%p\", o->name ? o->name : \"object\", (const void *)o);\n"
    "}\n"
    "static const mxy_vw mxy_vw_obj __attribute__((unused)) = {sizeof(void *), mxy_copy_obj, mxy_drop_obj, mxy_eq_ptr, mxy_hash_ptr, mxy_cmp_ptr, mxy_fmtp_obj, \"ref\"};\n"
    "/* moxy runtime: closures. Captured values live after the header; `fn` takes\n"
    "   the closure itself as its first argument. */\n"
    "typedef struct mxy_fn {\n"
    "    int64_t rc;\n"
    "    void *fn;\n"
    "    void (*drop)(struct mxy_fn *self);\n"
    "} mxy_fn;\n"
    "\n"
    "MXY_INLINE mxy_fn *mxy_fn_retain(mxy_fn *f) {\n"
    "    if (f) mxy_rc_inc(&f->rc);\n"
    "    return f;\n"
    "}\n"
    "\n"
    "MXY_FN void mxy_fn_release(mxy_fn *f) {\n"
    "    if (!f || !mxy_rc_dec(&f->rc)) return;\n"
    "    if (f->drop) f->drop(f);\n"
    "    free(f);\n"
    "}\n"
    "\n"
    "MXY_FN MXY_NORETURN void mxy_fn_null(const char *loc) { mxy_panic(loc, \"call of a null closure\"); }\n"
    "\n"
    "MXY_INLINE mxy_fn *mxy_fn_check(mxy_fn *f, const char *loc) {\n"
    "    if (!f) mxy_fn_null(loc);\n"
    "    return f;\n"
    "}\n"
    "\n"
    "MXY_FN void mxy_copy_fn(void *dst, const void *src) { *(mxy_fn **)dst = mxy_fn_retain(*(mxy_fn *const *)src); }\n"
    "MXY_FN void mxy_drop_fn(void *p) { mxy_fn_release(*(mxy_fn **)p); }\n"
    "MXY_FN void mxy_fmtp_fn(mxy_buf *b, const void *p, int nested) {\n"
    "    (void)p;\n"
    "    (void)nested;\n"
    "    mxy_buf_puts(b, \"<fn>\");\n"
    "}\n"
    "static const mxy_vw mxy_vw_fn __attribute__((unused)) = {sizeof(mxy_fn *), mxy_copy_fn, mxy_drop_fn, mxy_eq_ptr, mxy_hash_ptr, NULL, mxy_fmtp_fn, \"fn\"};\n"
    "/* moxy runtime: futures (one thread per async call). The thread owns its\n"
    "   arguments; handles are reference counted. The last handle joins a finished\n"
    "   thread or detaches a running one, which then frees the future itself. */\n"
    "#ifdef MXY_THREADS\n"
    "typedef struct mxy_future {\n"
    "    int64_t rc;\n"
    "    pthread_t thread;\n"
    "    pthread_mutex_t lock;\n"
    "    pthread_cond_t cond;\n"
    "    int done;\n"
    "    int orphaned;\n"
    "    const mxy_vw *vw;\n"
    "    void *args;\n"
    "    void (*run)(void *args, void *out);\n"
    "    void (*drop_args)(void *args);\n"
    "    char *result;\n"
    "} mxy_future;\n"
    "\n"
    "MXY_FN void mxy_future_free(mxy_future *f) {\n"
    "    if (f->vw->size) mxy_vw_drop(f->vw, f->result);\n"
    "    pthread_mutex_destroy(&f->lock);\n"
    "    pthread_cond_destroy(&f->cond);\n"
    "    free(f->result);\n"
    "    free(f);\n"
    "}\n"
    "\n"
    "MXY_FN void *mxy_future_main(void *p) {\n"
    "    mxy_future *f = (mxy_future *)p;\n"
    "    f->run(f->args, f->result);\n"
    "    if (f->drop_args) f->drop_args(f->args);\n"
    "    free(f->args);\n"
    "    f->args = NULL;\n"
    "    pthread_mutex_lock(&f->lock);\n"
    "    f->done = 1;\n"
    "    int orphaned = f->orphaned;\n"
    "    pthread_cond_broadcast(&f->cond);\n"
    "    pthread_mutex_unlock(&f->lock);\n"
    "    if (orphaned) mxy_future_free(f);\n"
    "    return NULL;\n"
    "}\n"
    "\n"
    "MXY_FN mxy_future *mxy_future_spawn(const mxy_vw *vw, void *args, void (*run)(void *, void *),\n"
    "                                    void (*drop_args)(void *)) {\n"
    "    mxy_future *f = (mxy_future *)mxy_zalloc(sizeof(mxy_future));\n"
    "    f->rc = 1;\n"
    "    f->vw = vw;\n"
    "    f->args = args;\n"
    "    f->run = run;\n"
    "    f->drop_args = drop_args;\n"
    "    f->result = (char *)mxy_zalloc(vw->size ? vw->size : 1);\n"
    "    pthread_mutex_init(&f->lock, NULL);\n"
    "    pthread_cond_init(&f->cond, NULL);\n"
    "    if (pthread_create(&f->thread, NULL, mxy_future_main, f) != 0) {\n"
    "        /* no thread available: run inline so the program still makes progress */\n"
    "        f->orphaned = 0;\n"
    "        mxy_future_main(f);\n"
    "        f->thread = pthread_self();\n"
    "        f->done = 2;\n"
    "    }\n"
    "    return f;\n"
    "}\n"
    "\n"
    "/* waits for completion; returns a borrowed pointer to the result */\n"
    "MXY_FN void *mxy_future_await(mxy_future *f, const char *loc) {\n"
    "    if (!f) mxy_panic(loc, \"await on a null future\");\n"
    "    pthread_mutex_lock(&f->lock);\n"
    "    while (!f->done) pthread_cond_wait(&f->cond, &f->lock);\n"
    "    pthread_mutex_unlock(&f->lock);\n"
    "    return f->result;\n"
    "}\n"
    "\n"
    "MXY_INLINE mxy_future *mxy_future_retain(mxy_future *f) {\n"
    "    if (f) mxy_rc_inc(&f->rc);\n"
    "    return f;\n"
    "}\n"
    "\n"
    "MXY_FN void mxy_future_release(mxy_future *f) {\n"
    "    if (!f || !mxy_rc_dec(&f->rc)) return;\n"
    "    pthread_mutex_lock(&f->lock);\n"
    "    int done = f->done;\n"
    "    if (!done) f->orphaned = 1;\n"
    "    pthread_mutex_unlock(&f->lock);\n"
    "    if (!done) {\n"
    "        pthread_detach(f->thread);\n"
    "        return;\n"
    "    }\n"
    "    if (done == 1) pthread_join(f->thread, NULL);\n"
    "    mxy_future_free(f);\n"
    "}\n"
    "\n"
    "MXY_FN void mxy_copy_future(void *dst, const void *src) { *(mxy_future **)dst = mxy_future_retain(*(mxy_future *const *)src); }\n"
    "MXY_FN void mxy_drop_future(void *p) { mxy_future_release(*(mxy_future **)p); }\n"
    "static const mxy_vw mxy_vw_future __attribute__((unused)) = {sizeof(mxy_future *), mxy_copy_future, mxy_drop_future, mxy_eq_ptr, mxy_hash_ptr, NULL, NULL, \"future\"};\n"
    "#else\n"
    "typedef struct mxy_future mxy_future;\n"
    "#endif\n"
    "\n"
    "static const mxy_vw mxy_vw_void __attribute__((unused)) = {0, NULL, NULL, NULL, NULL, NULL, NULL, \"void\"};\n"
    "/* moxy runtime: process arguments and assertion support */\n"
    "static int mxy_argc __attribute__((unused));\n"
    "static char **mxy_argv __attribute__((unused));\n"
    "\n"
    "MXY_FN mxy_list *mxy_args(void) {\n"
    "    mxy_list *l = mxy_list_new(&mxy_vw_str, mxy_argc);\n"
    "    for (int i = 0; i < mxy_argc; i++) {\n"
    "        mxy_str s = mxy_str_from(mxy_argv[i]);\n"
    "        mxy_list_push(&l, &mxy_vw_str, &s, 1);\n"
    "    }\n"
    "    return l;\n"
    "}\n"
    "\n"
    "MXY_FN MXY_NORETURN void mxy_assert_fail(const char *loc, const char *expr, mxy_str msg) {\n"
    "    fflush(stdout);\n"
    "    if (msg) fprintf(stderr, \"assertion failed: %s\\n  at %s\\n\", msg, loc);\n"
    "    else fprintf(stderr, \"assertion failed: %s\\n  at %s\\n\", expr, loc);\n"
    "    exit(1);\n"
    "}\n"
    "\n"
    "MXY_FN mxy_str mxy_read_line(void) {\n"
    "    mxy_buf b = {0};\n"
    "    int c;\n"
    "    int any = 0;\n"
    "    while ((c = fgetc(stdin)) != EOF) {\n"
    "        any = 1;\n"
    "        if (c == '\\n') break;\n"
    "        mxy_buf_putc(&b, (char)c);\n"
    "    }\n"
    "    if (!any) {\n"
    "        free(b.data);\n"
    "        return NULL;\n"
    "    }\n"
    "    if (b.len && b.data[b.len - 1] == '\\r') b.data[--b.len] = '\\0';\n"
    "    return mxy_str_from_buf(&b);\n"
    "}\n"
    "\n"
    "MXY_FN mxy_str mxy_read_file(mxy_str path, int *ok) {\n"
    "    FILE *f = path ? fopen(path, \"rb\") : NULL;\n"
    "    if (!f) {\n"
    "        *ok = 0;\n"
    "        return NULL;\n"
    "    }\n"
    "    mxy_buf b = {0};\n"
    "    char chunk[8192];\n"
    "    size_t n;\n"
    "    while ((n = fread(chunk, 1, sizeof(chunk), f)) > 0) mxy_buf_put(&b, chunk, (int64_t)n);\n"
    "    fclose(f);\n"
    "    *ok = 1;\n"
    "    return mxy_str_from_buf(&b);\n"
    "}\n"
    "\n"
    "MXY_FN bool mxy_write_file(mxy_str path, mxy_str data, const char *mode) {\n"
    "    FILE *f = path ? fopen(path, mode) : NULL;\n"
    "    if (!f) return false;\n"
    "    size_t n = (size_t)mxy_str_len(data);\n"
    "    bool ok = fwrite(data ? data : \"\", 1, n, f) == n;\n"
    "    return fclose(f) == 0 && ok;\n"
    "}\n"
    "";

typedef struct {
    const char *path;
    const char *source;
} StdEntry;

static const StdEntry std_entries[] = {
    {"std/debug.mxy",
    "// std/debug.mxy — markers for unfinished or impossible code.\n"
    "// panic(message) is built in.\n"
    "\n"
    "void todo(string what) {\n"
    "    panic(\"not yet implemented: \" + what);\n"
    "}\n"
    "\n"
    "void unreachable() {\n"
    "    panic(\"entered unreachable code\");\n"
    "}\n"
    ""},
    {"std/io.mxy",
    "// std/io.mxy — console and file input/output\n"
    "extern string mxy_read_line();\n"
    "extern string mxy_read_file(string path, int *ok);\n"
    "extern bool mxy_write_file(string path, string data, const char *mode);\n"
    "\n"
    "void eprint(string msg) { fprintf(stderr, \"%s\\n\", msg); }\n"
    "void eprintln(string msg) { eprint(msg); }\n"
    "\n"
    "// the next line from standard input, or null at end of input\n"
    "string readln() { return mxy_read_line(); }\n"
    "\n"
    "Result<string> read_file(string path) {\n"
    "    int ok = 0;\n"
    "    string data = mxy_read_file(path, &ok);\n"
    "    if (!ok) { return Err(\"cannot read \\(path)\"); }\n"
    "    return Ok(data);\n"
    "}\n"
    "\n"
    "Result<void> write_file(string path, string data) {\n"
    "    if (!mxy_write_file(path, data, \"wb\")) { return Err(\"cannot write \\(path)\"); }\n"
    "    return Ok();\n"
    "}\n"
    "\n"
    "Result<void> append_file(string path, string data) {\n"
    "    if (!mxy_write_file(path, data, \"ab\")) { return Err(\"cannot append to \\(path)\"); }\n"
    "    return Ok();\n"
    "}\n"
    "\n"
    "string[] read_lines(string path) {\n"
    "    Result<string> text = read_file(path);\n"
    "    match text {\n"
    "        Ok(s) => return s.lines(),\n"
    "        Err(e) => return[],\n"
    "    }\n"
    "}\n"
    ""},
    {"std/math.mxy",
    "// std/math.mxy — integer and floating point helpers. C's <math.h> is available too.\n"
    "#include <math.h>\n"
    "\n"
    "int abs_int(int x) { return x < 0 ? -x : x; }\n"
    "int min_int(int a, int b) { return a < b ? a : b; }\n"
    "int max_int(int a, int b) { return a > b ? a : b; }\n"
    "\n"
    "int clamp_int(int x, int lo, int hi) {\n"
    "    if (x < lo) { return lo; }\n"
    "    if (x > hi) { return hi; }\n"
    "    return x;\n"
    "}\n"
    "\n"
    "double min_float(double a, double b) { return a < b ? a : b; }\n"
    "double max_float(double a, double b) { return a > b ? a : b; }\n"
    "\n"
    "double clamp_float(double x, double lo, double hi) {\n"
    "    if (x < lo) { return lo; }\n"
    "    if (x > hi) { return hi; }\n"
    "    return x;\n"
    "}\n"
    "\n"
    "long gcd(long a, long b) {\n"
    "    if (a < 0) { a = -a; }\n"
    "    if (b < 0) { b = -b; }\n"
    "    while (b != 0) {\n"
    "        long t = a % b;\n"
    "        a = b;\n"
    "        b = t;\n"
    "    }\n"
    "    return a;\n"
    "}\n"
    "\n"
    "long pow_int(long base, int exp) {\n"
    "    long result = 1;\n"
    "    for _ in 0..exp { result *= base; }\n"
    "    return result;\n"
    "}\n"
    "\n"
    "int sum_ints(int[] xs) {\n"
    "    int total = 0;\n"
    "    for x in xs { total += x; }\n"
    "    return total;\n"
    "}\n"
    ""},
    {"std/os.mxy",
    "// std/os.mxy — process arguments, environment and commands\n"
    "#include <stdlib.h>\n"
    "\n"
    "extern string[] mxy_args();\n"
    "\n"
    "// the command line, program name first\n"
    "string[] args() { return mxy_args(); }\n"
    "\n"
    "// an environment variable, or null when it is not set\n"
    "string env(string name) {\n"
    "    char *value = getenv(name);\n"
    "    if (!value) { return null; }\n"
    "    return string(value);\n"
    "}\n"
    "\n"
    "bool has_env(string name) { return getenv(name) != null; }\n"
    "\n"
    "// runs a shell command and returns its exit status\n"
    "int run(string command) {\n"
    "    int status = system(command);\n"
    "    if (status == -1) { return -1; }\n"
    "    return (status >> 8) & 255;\n"
    "}\n"
    ""},
    {"std/string.mxy",
    "// std/string.mxy — helpers on top of the string methods\n"
    "// (s.len, s.contains(x), s.split(sep), s.trim(), s.upper(), s.replace(a, b), ...)\n"
    "\n"
    "int str_len(string s) { return (int)s.len; }\n"
    "bool str_eq(string a, string b) { return a == b; }\n"
    "bool str_contains(string haystack, string needle) { return haystack.contains(needle); }\n"
    "bool str_starts_with(string s, string prefix) { return s.starts_with(prefix); }\n"
    "bool str_ends_with(string s, string suffix) { return s.ends_with(suffix); }\n"
    "\n"
    "string join(string[] parts, string sep) { return parts.join(sep); }\n"
    "\n"
    "string pad_left(string s, int width, char fill) {\n"
    "    string out = s;\n"
    "    while (out.len < width) { out = string(fill) + out; }\n"
    "    return out;\n"
    "}\n"
    "\n"
    "string pad_right(string s, int width, char fill) {\n"
    "    string out = s;\n"
    "    while (out.len < width) { out = out + string(fill); }\n"
    "    return out;\n"
    "}\n"
    "\n"
    "string reverse(string s) {\n"
    "    string out = \"\";\n"
    "    for i in 0..s.len { out = out + string(s[s.len - 1 - i]); }\n"
    "    return out;\n"
    "}\n"
    "\n"
    "int count(string s, string sub) {\n"
    "    if (sub.len == 0) { return 0; }\n"
    "    return (int)s.split(sub).len - 1;\n"
    "}\n"
    ""},
    {"std/test.mxy",
    "// std/test.mxy — assertions with readable failure messages.\n"
    "// assert(condition) and assert(condition, \"message\") are built in.\n"
    "\n"
    "void assert_eq_int(long got, long want) {\n"
    "    if (got != want) { panic(\"expected \\(want), got \\(got)\"); }\n"
    "}\n"
    "\n"
    "void assert_eq_float(double got, double want, double tolerance) {\n"
    "    double diff = got - want;\n"
    "    if (diff < 0) { diff = -diff; }\n"
    "    if (diff > tolerance) { panic(\"expected \\(want), got \\(got)\"); }\n"
    "}\n"
    "\n"
    "void assert_eq_str(string got, string want) {\n"
    "    if (got != want) { panic(\"expected \\\"\\(want)\\\", got \\\"\\(got)\\\"\"); }\n"
    "}\n"
    "\n"
    "void assert_true(bool cond) {\n"
    "    if (!cond) { panic(\"expected true\"); }\n"
    "}\n"
    "\n"
    "void assert_false(bool cond) {\n"
    "    if (cond) { panic(\"expected false\"); }\n"
    "}\n"
    ""},
    {"std/time.mxy",
    "// std/time.mxy — clocks and sleeping\n"
    "#include <time.h>\n"
    "\n"
    "// milliseconds since the Unix epoch\n"
    "long now_ms() {\n"
    "    struct timespec ts;\n"
    "    clock_gettime(CLOCK_REALTIME, &ts);\n"
    "    return (long)ts.tv_sec * 1000 + (long)(ts.tv_nsec / 1000000);\n"
    "}\n"
    "\n"
    "// a monotonic clock for measuring durations, in milliseconds\n"
    "double monotonic_ms() {\n"
    "    struct timespec ts;\n"
    "    clock_gettime(CLOCK_MONOTONIC, &ts);\n"
    "    return (double)ts.tv_sec * 1000.0 + (double)ts.tv_nsec / 1000000.0;\n"
    "}\n"
    "\n"
    "void sleep_ms(long ms) {\n"
    "    struct timespec ts;\n"
    "    ts.tv_sec = ms / 1000;\n"
    "    ts.tv_nsec = (ms % 1000) * 1000000;\n"
    "    nanosleep(&ts, null);\n"
    "}\n"
    ""},
};

const char *embed_runtime(void) { return runtime_src; }

int embed_std_count(void) { return (int)(sizeof(std_entries) / sizeof(std_entries[0])); }

const char *embed_std_name(int index) {
    if (index < 0 || index >= embed_std_count()) return NULL;
    return std_entries[index].path;
}

const char *embed_std(const char *path) {
    for (int i = 0; i < embed_std_count(); i++)
        if (strcmp(std_entries[i].path, path) == 0) return std_entries[i].source;
    return NULL;
}
