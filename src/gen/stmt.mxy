#include <string.h>

#include "index.mxy"

Node *cur_func;
Type *cur_ret;
GScopeVec gscopes;

void gscope_push(int kind) {
    GScope s;
    memset(&s, 0, sizeof(s));
    s.kind = kind;
    vec_push(gscopes, s);
}

void add_cleanup_var(const char *name, Type *t, Sym *sym) {
    Cleanup cl = {CL_VAR, xstrdup(name), t, NULL, sym};
    vec_push(vec_last(gscopes).items, cl);
}

static void add_defer(Node *stmt) {
    Cleanup cl = {CL_DEFER, NULL, NULL, stmt, NULL};
    vec_push(vec_last(gscopes).items, cl);
}

static void emit_cleanup(Buf *b, int indent, Cleanup *cl, const char *skip) {
    if (cl->kind == CL_VAR) {
        if (skip && strcmp(cl->name, skip) == 0) return;
        release_into(b, indent, cl->type, cl->name);
    } else if (cl->kind == CL_DEFER) {
        /* deferred code runs against its own scope stack (it cannot jump out) */
        GScopeVec saved = gscopes;
        memset(&gscopes, 0, sizeof(gscopes));
        gscope_push(GS_BLOCK);
        gen_stmt(cl->stmt, b, indent);
        gscope_pop(b, indent);
        vec_free(gscopes);
        gscopes = saved;
    }
}

static void emit_scope(Buf *b, int indent, GScope *s, const char *skip) {
    for (int i = s->items.len - 1; i >= 0; i--) {
        Cleanup cl = s->items.items[i];
        emit_cleanup(b, indent, &cl, skip);
    }
}

/* release everything from the innermost scope down to (and including) depth */
void emit_cleanups_to(Buf *b, int indent, int depth, const char *skip) {
    for (int i = gscopes.len - 1; i >= depth; i--) {
        GScope s = gscopes.items[i];
        emit_scope(b, indent, &s, skip);
    }
}

void gscope_pop(Buf *b, int indent) {
    GScope s = vec_last(gscopes);
    gscopes.len--;
    if (!s.dead) emit_scope(b, indent, &s, NULL);
    vec_free(s.items);
}

/* writes a finished statement: its prelude, the main line, then temp releases */
static void flush(Ctx *c, Buf *b, Loc loc, const char *main_line) {
    if (c->pre.len) {
        const char *p = buf_str(&c->pre);
        while (*p) {
            const char *e = strchr(p, '\n');
            size_t n = e ? (size_t)(e - p) : strlen(p);
            mark_loc(b, loc);
            buf_putn(b, p, n);
            buf_putc(b, '\n');
            p += n + (e ? 1 : 0);
        }
    }
    if (main_line) line_at(b, c->indent, loc, "%s", main_line);
    if (c->temps.len) {
        Buf rel = {0};
        ctx_release(c, &rel);
        if (rel.len) buf_put(b, buf_str(&rel));
        buf_free(&rel);
    }
}

static int in_function(Sym *s) {
    for (int i = 0; i < gscopes.len; i++)
        for (int j = 0; j < gscopes.items[i].items.len; j++)
            if (gscopes.items[i].items.items[j].sym == s && gscopes.items[i].items.items[j].kind == CL_VAR) return 1;
    return 0;
}

static void gen_local_var(Node *n, Buf *b, int indent) {
    Sym *s = n->sym;
    Type *t = s ? s->type : n->type;
    const char *name = s ? s->cname : n->name;
    Type *u = type_unqual(t);
    int m = managed(t);
    Ctx c;
    ctx_init(&c, indent);
    char *d = cdecl(t, name);
    if (n->flags & F_STATIC) {
        char *v = n->a ? gen_init(n->a, t, &c).s : NULL;
        char *line = v ? xfmt("static %s = %s;", d, v) : xfmt("static %s;", d);
        flush(&c, b, n->loc, line);
        ctx_free(&c);
        return;
    }
    if (!n->a) {
        char *line = m ? xfmt("%s = {0};", d) : xfmt("%s;", d);
        flush(&c, b, n->loc, line);
    } else {
        CExpr e = gen_init(n->a, t, &c);
        char *v = m ? consume(&c, e, t) : borrow(&c, e, t);
        if (n->op == 1 && u->kind == TY_UNKNOWN) d = xfmt("__auto_type %s", name);
        char *line = xfmt("%s = %s;", d, v);
        flush(&c, b, n->loc, line);
    }
    if (m || (u->kind == TY_ARRAY && managed(u->base))) add_cleanup_var(name, t, s);
    ctx_free(&c);
}

static void gen_expr_stmt(Node *n, Buf *b, int indent) {
    Ctx c;
    ctx_init(&c, indent);
    CExpr e = gen_expr(n->a, &c);
    char *line = NULL;
    if (strcmp(e.s, "((void)0)") != 0) {
        if (e.owned && managed(n->a->type)) line = xfmt("%s;", release_expr(n->a->type, e.s));
        else if (n->a->kind == N_ASSIGN && (e.s[0] != '(' || n->a->builtin || strncmp(e.s, "(*", 2) == 0))
            line = xfmt("(void)%s;", e.s);
        else if (n->a->kind == N_CALL || n->a->kind == N_ASSIGN || n->a->kind == N_UNARY || n->a->kind == N_POSTFIX)
            line = xfmt("%s;", e.s);
        else line = xfmt("(void)%s;", e.s);
    }
    flush(&c, b, n->loc, line);
    ctx_free(&c);
}

/* statements of a body inside an already-open C block, in a fresh scope */
static void gen_body(Node *n, Buf *b, int indent) {
    gscope_push(GS_BLOCK);
    if (n->kind == N_BLOCK) gen_block_body(&n->list, b, indent);
    else gen_stmt(n, b, indent);
    gscope_pop(b, indent);
}

void gen_block_body(NodeList *list, Buf *b, int indent) {
    for (int i = 0; i < list->len; i++) gen_stmt(list->items[i], b, indent);
    if (!list->len || !gscopes.len) return;
    NodeKind last = list->items[list->len - 1]->kind;
    if (last == N_RETURN || last == N_BREAK || last == N_CONTINUE || last == N_GOTO) vec_last(gscopes).dead = 1;
}

char *strip_parens(char *s) {
    size_t n = strlen(s);
    if (n < 2 || s[0] != '(' || s[n - 1] != ')') return s;
    int depth = 0;
    for (size_t i = 0; i < n; i++) {
        if (s[i] == '"' || s[i] == '\'') {
            char q = s[i];
            for (i++; i < n && s[i] != q; i++)
                if (s[i] == '\\') i++;
            continue;
        }
        if (s[i] == '(') depth++;
        else if (s[i] == ')') depth--;
        if (depth == 0 && i < n - 1) return s;
    }
    return xstrndup(s + 1, n - 2);
}

/* a condition without redundant parentheses; an assignment keeps them, as C expects */
char *cond_text(Node *cond, char *s) { return cond->kind == N_ASSIGN ? s : strip_parens(s); }

static char *cond_value(Node *cond, Buf *b, int indent) {
    Ctx c;
    ctx_init(&c, indent);
    char *v = gen_value(cond, &c);
    if (!c.pre.len && !c.temps.len) {
        ctx_free(&c);
        return cond_text(cond, v);
    }
    char *name = fresh("c");
    char *line = xfmt("bool %s = (%s) ? 1 : 0;", name, v);
    flush(&c, b, cond->loc, line);
    ctx_free(&c);
    return name;
}

static void gen_if(Node *n, Buf *b, int indent) {
    char *cond = cond_value(n->a, b, indent);
    line_at(b, indent, n->loc, "if (%s) {", cond);
    gen_body(n->b, b, indent + 1);
    if (n->c) {
        raw_line(b, indent, "} else {");
        gen_body(n->c, b, indent + 1);
    }
    raw_line(b, indent, "}");
}

static int innermost(int kind1, int kind2) {
    for (int i = gscopes.len - 1; i >= 0; i--)
        if (gscopes.items[i].kind == kind1 || gscopes.items[i].kind == kind2) return i;
    return -1;
}

static void gen_return(Node *n, Buf *b, int indent) {
    if (!n->a) {
        emit_cleanups_to(b, indent, 0, NULL);
        line_at(b, indent, n->loc, "return;");
        return;
    }
    Ctx c;
    ctx_init(&c, indent);
    Type *rt = cur_ret;
    Node *v = n->a;
    if (managed(rt) && v->kind == N_IDENT && v->sym && v->sym->kind == S_VAR && !v->sym->global &&
        !capture_ref(v->sym) && in_function(v->sym) && type_eq(v->type, rt)) {
        flush(&c, b, n->loc, NULL);
        emit_cleanups_to(b, indent, 0, v->sym->cname);
        line_at(b, indent, n->loc, "return %s;", v->sym->cname);
        ctx_free(&c);
        return;
    }
    CExpr e = gen_init(v, rt, &c);
    char *val = managed(rt) ? consume(&c, e, rt) : borrow(&c, e, rt);
    if (val[0] == '{') val = xfmt("(%s)%s", ctype(rt), val);
    int needs_cleanup = 0;
    for (int i = 0; i < gscopes.len; i++)
        if (gscopes.items[i].items.len) needs_cleanup = 1;
    if (!needs_cleanup && !c.temps.len) {
        char *line = xfmt("return %s;", val);
        flush(&c, b, n->loc, line);
        ctx_free(&c);
        return;
    }
    char *r = fresh("ret");
    char *line = xfmt("%s = %s;", cdecl(rt, r), val);
    flush(&c, b, n->loc, line);
    emit_cleanups_to(b, indent, 0, NULL);
    line_at(b, indent, n->loc, "return %s;", r);
    ctx_free(&c);
}

static void gen_break(Node *n, Buf *b, int indent, int is_continue) {
    int target = is_continue ? innermost(GS_LOOP, GS_LOOP) : innermost(GS_LOOP, GS_SWITCH);
    if (target >= 0) emit_cleanups_to(b, indent, target + 1, NULL);
    if (is_continue && target >= 0 && gscopes.items[target].continue_label)
        line_at(b, indent, n->loc, "goto %s;", gscopes.items[target].continue_label);
    else
        line_at(b, indent, n->loc, is_continue ? "continue;" : "break;");
}

static void gen_switch(Node *n, Buf *b, int indent) {
    Ctx c;
    ctx_init(&c, indent);
    char *v = gen_value(n->a, &c);
    char *line = xfmt("switch (%s) {", v);
    flush(&c, b, n->loc, line);
    ctx_free(&c);
    gscope_push(GS_SWITCH);
    if (n->b->kind == N_BLOCK) gen_block_body(&n->b->list, b, indent + 1);
    else gen_stmt(n->b, b, indent + 1);
    gscope_pop(b, indent + 1);
    raw_line(b, indent, "}");
}

void gen_stmt(Node *n, Buf *b, int indent) {
    switch (n->kind) {
    case N_BLOCK:
        raw_line(b, indent, "{");
        gen_body(n, b, indent + 1);
        raw_line(b, indent, "}");
        break;
    case N_DECLS:
        for (int i = 0; i < n->list.len; i++)
            if (n->list.items[i]->kind == N_VAR) gen_local_var(n->list.items[i], b, indent);
        break;
    case N_EXPR:
        gen_expr_stmt(n, b, indent);
        break;
    case N_IF:
        gen_if(n, b, indent);
        break;
    case N_WHILE: case N_DO: case N_FOR: case N_FORIN:
        gen_loop(n, b, indent);
        break;
    case N_RETURN:
        gen_return(n, b, indent);
        break;
    case N_BREAK:
        gen_break(n, b, indent, 0);
        break;
    case N_CONTINUE:
        gen_break(n, b, indent, 1);
        break;
    case N_GOTO:
        line_at(b, indent, n->loc, "goto %s;", n->name);
        break;
    case N_LABEL:
        line_at(b, indent > 0 ? indent - 1 : 0, n->loc, "%s:;", n->name);
        gen_stmt(n->a, b, indent);
        break;
    case N_SWITCH:
        gen_switch(n, b, indent);
        break;
    case N_CASE: {
        Ctx c;
        ctx_init(&c, indent);
        char *v = gen_value(n->a, &c);
        if (n->b) line_at(b, indent > 0 ? indent - 1 : 0, n->loc, "case %s ... %s:;", v, gen_value(n->b, &c));
        else line_at(b, indent > 0 ? indent - 1 : 0, n->loc, "case %s:;", v);
        ctx_free(&c);
        break;
    }
    case N_DEFAULT:
        line_at(b, indent > 0 ? indent - 1 : 0, n->loc, "default:;");
        break;
    case N_MATCH:
        gen_match(n, b, indent);
        break;
    case N_DEFER:
        add_defer(n->a);
        break;
    case N_DIRECTIVE:
        buf_fmt(b, "%s\n", n->text);
        break;
    case N_STATIC_ASSERT: {
        Ctx c;
        ctx_init(&c, indent);
        char *v = gen_value(n->a, &c);
        char *m = n->b ? c_string_lit(n->b->text) : xstrdup("\"static assertion\"");
        line_at(b, indent, n->loc, "_Static_assert(%s, %s);", v, m);
        ctx_free(&c);
        break;
    }
    case N_EMPTY:
        line_at(b, indent, n->loc, ";");
        break;
    default:
        break;
    }
}
