#include <string.h>

#include "index.mxy"

static int c_friendly(Type *t) {
    Type *u = type_unqual(t);
    switch (u->kind) {
    case TY_RESULT: case TY_ENUM:
        return 0;
    case TY_STRUCT:
        return u->is_ref || !u->decl || !type_is_managed(u);
    case TY_PTR: case TY_ARRAY:
        return 1;
    default:
        return 1;
    }
}

/* a C header describing a library's exported functions */
char *gen_header(const char *libname) {
    Buf b = {0};
    char *guard = xfmt("MOXY_LIB_%s_H", libname);
    for (char *p = guard; *p; p++)
        if (*p >= 'a' && *p <= 'z') *p = (char)(*p - 32);
        else if (!((*p >= 'A' && *p <= 'Z') || (*p >= '0' && *p <= '9'))) *p = '_';
    buf_fmt(&b, "/* generated by moxy: C interface for %s */\n#ifndef %s\n#define %s\n\n", libname, guard, guard);
    buf_put(&b, "#include <stdbool.h>\n#include <stdint.h>\n\n");
    buf_put(&b, "typedef const char *mxy_str;\ntypedef struct mxy_list mxy_list;\ntypedef struct mxy_map mxy_map;\n");
    buf_put(&b, "typedef struct mxy_fn mxy_fn;\ntypedef struct mxy_future mxy_future;\n\n");
    for (int i = 0; i < prog.structs.len; i++) {
        Type *t = prog.structs.items[i]->type;
        if (!t || !t->cname || str_starts(t->cname, "struct ") || (prog.structs.items[i]->flags & F_INLINE)) continue;
        buf_fmt(&b, "typedef %s %s %s;\n", t->is_union ? "union" : "struct", t->cname, t->cname);
    }
    buf_put(&b, "\n");
    /* plain structs are part of the C interface; managed ones stay opaque */
    for (int i = 0; i < prog.structs.len; i++) {
        Node *d = prog.structs.items[i];
        Type *t = d->type;
        if (!t || t->is_ref || type_is_managed(t) || (d->flags & F_INLINE) || !(d->flags & F_BODY)) continue;
        buf_fmt(&b, "%s %s {\n", t->is_union ? "union" : "struct", t->cname);
        for (int j = 0; j < d->list.len; j++) {
            Node *f = d->list.items[j];
            if (f->kind != N_FIELD || !f->name) continue;
            buf_fmt(&b, "    %s;\n", type_cdecl(f->type, f->name));
        }
        buf_put(&b, "};\n");
    }
    buf_put(&b, "\n");
    for (int i = 0; i < prog.funcs.len; i++) {
        Node *fn = prog.funcs.items[i];
        Sym *s = fn->sym;
        if (!fn->a || !s || s->decl != fn || (fn->flags & (F_STATIC | F_INLINE)) || s->is_async) continue;
        if (fn == prog.main || strcmp(fn->name, "main") == 0) continue;
        Type *ft = type_unqual(s->type);
        int ok = c_friendly(ft->base);
        for (int j = 0; j < ft->params.len; j++) ok = ok && c_friendly(ft->params.items[j]);
        if (!ok) {
            buf_fmt(&b, "/* %s: uses Moxy value types; call it from Moxy */\n", fn->name);
            continue;
        }
        Buf params = {0};
        for (int j = 0; j < ft->params.len; j++) {
            Param *p = &fn->params.items[j];
            buf_fmt(&params, "%s%s", j ? ", " : "", type_cdecl(ft->params.items[j], p->name ? p->name : ""));
        }
        if (ft->variadic) buf_put(&params, ft->params.len ? ", ..." : "...");
        if (!params.len) buf_put(&params, "void");
        char *decl = type_cdecl(ft->base, xfmt("%s(%s)", s->cname, buf_str(&params)));
        buf_fmt(&b, "%s;\n", decl);
    }
    buf_fmt(&b, "\n#endif\n");
    return buf_take(&b);
}
