#include <dirent.h>
#include <stdio.h>
#include <string.h>
#include <unistd.h>

#include "index.mxy"
#include "conf/index.mxy"
#include "fmt/index.mxy"

void collect_mxy(const char *dir, StrList *out) {
    if (str_ends(dir, ".mxy") && file_exists(dir)) {
        vec_push(*out, xstrdup(dir));
        return;
    }
    DIR *d = opendir(dir);
    if (!d) return;
    struct dirent *e;
    StrList names = {0};
    while ((e = readdir(d))) vec_push(names, xstrdup(e->d_name));
    closedir(d);
    for (int i = 0; i < names.len; i++)
        for (int j = i + 1; j < names.len; j++)
            if (strcmp(names.items[i], names.items[j]) > 0) {
                char *t = names.items[i];
                names.items[i] = names.items[j];
                names.items[j] = t;
            }
    for (int i = 0; i < names.len; i++) {
        const char *name = names.items[i];
        if (name[0] == '.' || strcmp(name, "build") == 0 || strcmp(name, "packages") == 0) continue;
        char *path = strcmp(dir, ".") == 0 ? xstrdup(name) : path_join(dir, name);
        if (dir_exists(path)) collect_mxy(path, out);
        else if (str_ends(name, ".mxy")) vec_push(*out, path);
    }
}

static MoxyConfig config_near(const char *file) {
    char *dir = path_dir(file);
    char cwd[4096];
    char *found = mxyconf_find(getcwd(cwd, sizeof(cwd)) ? cwd : ".", dir);
    MoxyConfig cfg = found ? mxyconf_load(found) : mxyconf_defaults();
    free(dir);
    free(found);
    return cfg;
}

int cmd_fmt(int argc, char **argv) {
    int check = 0;
    StrList files = {0};
    for (int i = 0; i < argc; i++) {
        if (strcmp(argv[i], "--check") == 0) check = 1;
        else collect_mxy(argv[i], &files);
    }
    if (!argc || (argc == 1 && check)) collect_mxy(".", &files);
    int changed = 0;
    for (int i = 0; i < files.len; i++) {
        char *src = file_read(files.items[i]);
        if (!src) continue;
        MoxyConfig cfg = config_near(files.items[i]);
        char *out = fmt_source(src, &cfg);
        if (strcmp(src, out) == 0) continue;
        changed++;
        if (check) {
            printf("  %s needs formatting\n", files.items[i]);
        } else {
            file_write(files.items[i], out);
            printf("  formatted %s\n", files.items[i]);
        }
    }
    if (check && changed) {
        printf("\n  %d file%s need formatting (run moxy fmt)\n", changed, changed == 1 ? "" : "s");
        return 1;
    }
    return 0;
}
