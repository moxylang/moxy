#include "base/index.mxy"

typedef struct {
    char **items;
    int len;
    int cap;
} StrList;

/* compile.mxy: .mxy -> C */
typedef struct {
    int line_directives;
    int lint;
    const char *c_name;
} CompileOpts;

char *compile_to_c(const char *path, const CompileOpts *o, int *uses_threads, int *has_main);
int check_file(const char *path, int lint);
void source_dirs(StrList *out);

/* cc.mxy: C -> binary */
typedef struct {
    const char *cc;
    const char *cflags;
    const char *ldflags;
    const char *output;
    StrList sources;
    StrList includes;
    int release;
    int threads;
    int object_only;
    int sanitize;
} CcOpts;

int cc_run(const CcOpts *o);
char *shell_quote(const char *s);
char *make_temp_dir(void);
void remove_tree(const char *path);
int run_binary(const char *path, int argc, char **argv);

/* file.mxy: single-file commands */
int cmd_emit(int argc, char **argv);
int cmd_run_file(int argc, char **argv);
int cmd_build_file(int argc, char **argv);
int cmd_check(int argc, char **argv);

/* test.mxy */
int run_tests(StrList *paths, int sanitize, int release);
int cmd_test_files(int argc, char **argv);

/* fmtcmd.mxy / lintcmd.mxy */
int cmd_fmt(int argc, char **argv);
int cmd_lint(int argc, char **argv);
void collect_mxy(const char *dir, StrList *out);

/* project.mxy */
int project_main(int argc, char **argv);

#include "cc.mxy"
#include "compile.mxy"
#include "file.mxy"
#include "fmtcmd.mxy"
#include "lintcmd.mxy"
#include "project.mxy"
#include "test.mxy"
