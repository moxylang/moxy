#include <stdio.h>
#include <string.h>
#include <unistd.h>

#include "cli/index.mxy"

static void usage(void) {
    printf("moxy %s - C with modern conveniences and automatic memory management\n\n", MOXY_VERSION_STR);
    printf("files:\n");
    printf("  moxy <file.mxy>                    print the generated C\n");
    printf("  moxy run [--release] <file.mxy> [args]   build and run one file\n");
    printf("  moxy build <file.mxy> [-o out]     build one file\n");
    printf("  moxy check [files|dirs]            type-check without building\n");
    printf("  moxy test [files|dirs] [--sanitize]   run tests (tests/ and *.test.mxy)\n");
    printf("  moxy fmt [files] [--check]         format source\n");
    printf("  moxy lint [files]                  report unused or shadowed variables\n\n");
    printf("projects (moxy.yaml):\n");
    printf("  moxy new <name> | init             create a project\n");
    printf("  moxy build | run | test [--release] [-p member]\n");
    printf("  moxy add <git-url> [--name n] [--version v] | remove <name> | update\n");
    printf("  moxy clean | install [--prefix dir] | task <name>\n");
}

static int has_mxy_arg(int argc, char **argv) {
    for (int i = 2; i < argc; i++)
        if (str_ends(argv[i], ".mxy")) return 1;
    return 0;
}

/* `-p member` runs a project command inside a workspace member */
static int with_member(int argc, char **argv) {
    for (int i = 2; i + 1 < argc; i++) {
        if (strcmp(argv[i], "-p") != 0) continue;
        if (chdir(argv[i + 1]) != 0) {
            fprintf(stderr, "moxy: no workspace member '%s'\n", argv[i + 1]);
            return 1;
        }
        for (int j = i; j + 2 <= argc; j++) argv[j] = argv[j + 2];
        return project_main(argc - 2, argv);
    }
    return -1;
}

int main(int argc, char **argv) {
    int first = 1;
    while (first < argc && str_starts(argv[first], "--enable-")) first++;
    if (first > 1) {
        for (int i = first; i < argc; i++) argv[i - first + 1] = argv[i];
        argc -= first - 1;
    }
    if (argc < 2) {
        usage();
        return 1;
    }
    const char *cmd = argv[1];
    if (strcmp(cmd, "--help") == 0 || strcmp(cmd, "-h") == 0 || strcmp(cmd, "help") == 0) {
        usage();
        return 0;
    }
    if (strcmp(cmd, "--version") == 0 || strcmp(cmd, "-V") == 0 || strcmp(cmd, "version") == 0) {
        printf("moxy %s\n", MOXY_VERSION_STR);
        return 0;
    }
    if (str_ends(cmd, ".mxy")) return cmd_emit(argc - 1, argv + 1);
    if (strcmp(cmd, "emit") == 0) return cmd_emit(argc - 2, argv + 2);
    if (strcmp(cmd, "check") == 0) return cmd_check(argc - 2, argv + 2);
    if (strcmp(cmd, "fmt") == 0) return cmd_fmt(argc - 2, argv + 2);
    if (strcmp(cmd, "lint") == 0) return cmd_lint(argc - 2, argv + 2);
    if (strcmp(cmd, "run") == 0 && has_mxy_arg(argc, argv)) return cmd_run_file(argc - 2, argv + 2);
    if (strcmp(cmd, "build") == 0 && has_mxy_arg(argc, argv)) return cmd_build_file(argc - 2, argv + 2);
    if (strcmp(cmd, "test") == 0 && (has_mxy_arg(argc, argv) || !file_exists("moxy.yaml")))
        return cmd_test_files(argc - 2, argv + 2);
    int rc = with_member(argc, argv);
    if (rc >= 0) return rc;
    return project_main(argc, argv);
}
