#include "base/index.mxy"
#include "lex/index.mxy"

typedef struct Node Node;
typedef struct TypeRef TypeRef;
typedef struct Type Type;
typedef struct Sym Sym;

typedef struct {
    Node **items;
    int len;
    int cap;
} NodeList;
typedef struct {
    TypeRef **items;
    int len;
    int cap;
} TypeRefList;
typedef struct {
    Sym **items;
    int len;
    int cap;
} SymList;

/* qualifiers */
enum { Q_CONST = 1, Q_VOLATILE = 2, Q_RESTRICT = 4 };

/* type syntax, resolved by sema into Type */
typedef enum {
    TR_NAME,    /* name: "int", "unsigned long", "Point", "geo::Point" */
    TR_PTR,     /* inner */
    TR_ARRAY,   /* inner, size (may be NULL) */
    TR_FUNC,    /* inner = return, params, variadic */
    TR_LIST,    /* inner */
    TR_MAP,     /* key, inner = value */
    TR_RESULT,  /* inner */
    TR_FUTURE,  /* inner */
    TR_CLOSURE, /* inner = return, params */
    TR_TAG,     /* struct/union/enum tag: tag = K_STRUCT..., name, def */
} TypeRefKind;

struct TypeRef {
    TypeRefKind kind;
    Loc loc;
    char *name;
    int tag;
    int quals;
    TypeRef *inner;
    TypeRef *key;
    Node *size;
    TypeRefList params;
    int variadic;
    Node *def;
    Type *resolved;
};

typedef struct {
    char *name;
    TypeRef *type;
    Loc loc;
    Sym *sym;
} Param;

typedef struct {
    Param *items;
    int len;
    int cap;
} ParamList;

typedef enum {
    /* declarations */
    N_FUNC,        /* name, tref = return, params, a = body | NULL, flags */
    N_VAR,         /* name, tref, a = init | NULL, flags */
    N_TYPEDEF,     /* name, tref */
    N_STRUCT,      /* name (tag, may be NULL), list = N_FIELD | N_DIRECTIVE, flags F_UNION F_REF F_BODY */
    N_FIELD,       /* name (may be NULL), tref, a = bit width, flags F_WEAK */
    N_ENUM,        /* moxy enum: name, list = N_VARIANT */
    N_VARIANT,     /* name, params = payload fields */
    N_CENUM,       /* C enum: name (may be NULL), list = N_ENUMERATOR, flags F_BODY */
    N_ENUMERATOR,  /* name, a = value | NULL */
    N_NAMESPACE,   /* name, list = decls */
    N_USING,       /* name = namespace path */
    N_DIRECTIVE,   /* text */
    N_STATIC_ASSERT, /* a = cond, b = message */

    /* statements */
    N_BLOCK,       /* list */
    N_DECLS,       /* list = N_VAR (one per declarator) | N_STRUCT | N_CENUM | N_TYPEDEF */
    N_EXPR,        /* a */
    N_IF,          /* a cond, b then, c else */
    N_WHILE,       /* a cond, b body */
    N_DO,          /* a body, b cond */
    N_FOR,         /* a init, b cond, c step, d body (any may be NULL except d) */
    N_FORIN,       /* name, name2 (optional), a = iterable | N_RANGE, d = body */
    N_RETURN,      /* a */
    N_BREAK,
    N_CONTINUE,
    N_GOTO,        /* name */
    N_LABEL,       /* name, a = statement */
    N_SWITCH,      /* a cond, b body */
    N_CASE,        /* a value, b = range end (gnu) | NULL */
    N_DEFAULT,
    N_MATCH,       /* a scrutinee, list = N_ARM */
    N_ARM,         /* name = pattern path ("Shape::Circle", "Ok", "_"), list = bindings (N_IDENT), b = literal pattern, a = body */
    N_DEFER,       /* a = statement */
    N_EMPTY,

    /* expressions */
    N_INT,         /* text */
    N_FLOAT,       /* text */
    N_CHAR,        /* text (inside quotes) */
    N_STR,         /* text (inside quotes, escapes kept) */
    N_INTERP,      /* list: N_STR pieces and expressions */
    N_BOOL,        /* op = 1 | 0 */
    N_NULL,
    N_IDENT,       /* name (may contain "::") */
    N_UNARY,       /* op, a */
    N_POSTFIX,     /* op, a */
    N_BINARY,      /* op, a, b */
    N_ASSIGN,      /* op, a target, b value */
    N_TERNARY,     /* a, b, c */
    N_COMMA,       /* a, b */
    N_CALL,        /* a callee, list args */
    N_INDEX,       /* a, b */
    N_MEMBER,      /* a, name, op = P_DOT | P_ARROW */
    N_CAST,        /* tref, a */
    N_SIZEOF,      /* tref | a */
    N_ALIGNOF,     /* tref */
    N_COMPOUND,    /* tref, b = N_INITLIST */
    N_INITLIST,    /* list = exprs | N_DESIG | N_KV */
    N_DESIG,       /* name (.field) | a ([index]), b value */
    N_KV,          /* a key, b value (map literal entry) */
    N_LIST,        /* list items */
    N_OK,          /* a */
    N_ERR,         /* a */
    N_AWAIT,       /* a */
    N_LAMBDA,      /* params, a = body (expr or N_BLOCK), flags F_EXPRBODY */
    N_RANGE,       /* a, b, flags F_INCLUSIVE */
    N_STRUCTLIT,   /* tref, b = N_INITLIST */

    N_TYPEARG,     /* tref: a type passed to a C macro such as va_arg(ap, int) */

    /* inserted by sema */
    N_CONV,        /* a, type = target; conversion */
} NodeKind;

enum {
    F_STATIC = 1 << 0,
    F_EXTERN = 1 << 1,
    F_INLINE = 1 << 2,
    F_UNION = 1 << 3,
    F_REF = 1 << 4,
    F_BODY = 1 << 5,
    F_WEAK = 1 << 6,
    F_EXPRBODY = 1 << 7,
    F_INCLUSIVE = 1 << 8,
    F_GLOBAL = 1 << 9,
    F_NORETURN = 1 << 10,
    F_THREADLOCAL = 1 << 11,
    F_ARROWPATTERN = 1 << 12,
    F_PARENS = 1 << 13,
};

struct Node {
    NodeKind kind;
    Loc loc;
    int op;
    int flags;
    char *name;
    char *name2;
    char *text;
    char *cond;      /* enclosing preprocessor condition (top level) */
    char *ns;        /* enclosing namespace path (top level), "" for global */
    Node *a, *b, *c, *d;
    NodeList list;
    TypeRef *tref;
    ParamList params;

    /* filled in by sema */
    Type *type;
    Sym *sym;
    int builtin;
    int lvalue;
    SymList captures;
    int id;
};

Node *node_new(NodeKind kind, Loc loc);
TypeRef *tref_new(TypeRefKind kind, Loc loc);
Node *node_clone(Node *n);

#include "ast.mxy"
