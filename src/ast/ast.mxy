#include "index.mxy"

#include <string.h>

Node *node_new(NodeKind kind, Loc loc) {
    Node *n = xcalloc(1, sizeof(Node));
    n->kind = kind;
    n->loc = loc;
    return n;
}

TypeRef *tref_new(TypeRefKind kind, Loc loc) {
    TypeRef *t = xcalloc(1, sizeof(TypeRef));
    t->kind = kind;
    t->loc = loc;
    return t;
}

/* shallow-ish clone for defer bodies; children are shared */
Node *node_clone(Node *n) {
    Node *c = xmalloc(sizeof(Node));
    memcpy(c, n, sizeof(Node));
    return c;
}
