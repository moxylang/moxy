#include <string.h>

#include "diag/index.mxy"
#include "index.mxy"

Type *check_init(Node **slot, Type *t);
Type *check_method(Node **slot, Type *expected);

Node *find_variant(Type *e, const char *name) {
    Type *u = type_unqual(e);
    if (!u || u->kind != TY_ENUM || !u->decl) return NULL;
    for (int i = 0; i < u->decl->list.len; i++) {
        Node *v = u->decl->list.items[i];
        if (strcmp(v->name, name) == 0) return v;
    }
    return NULL;
}

/* Enum::Variant or Enum::Variant(args); n is N_IDENT or N_CALL */
Type *variant_ctor(Node *n, Sym *enum_sym, const char *variant, Type *expected) {
    (void)expected;
    Type *e = enum_sym->type;
    Node *v = find_variant(e, variant);
    if (!v) {
        diag_error(n->loc, "%s has no variant '%s'", type_unqual(e)->name, variant);
        return e;
    }
    n->builtin = B_ENUM_CTOR;
    n->name2 = xstrdup(variant);
    n->d = v;
    NodeList *args = n->kind == N_CALL ? &n->list : NULL;
    int nargs = args ? args->len : 0;
    if (nargs != v->params.len) {
        if (!args && v->params.len)
            diag_error(n->loc, "%s::%s carries %d value%s; pass them in parentheses", type_unqual(e)->name, variant,
                       v->params.len, v->params.len == 1 ? "" : "s");
        else
            diag_error(n->loc, "%s::%s takes %d value%s, got %d", type_unqual(e)->name, variant, v->params.len,
                       v->params.len == 1 ? "" : "s", nargs);
    }
    for (int i = 0; i < nargs && i < v->params.len; i++) {
        Type *pt = v->params.items[i].type->resolved;
        check_init(&args->items[i], pt);
        coerce(&args->items[i], pt, "variant value");
    }
    return e;
}

static void check_args(Node *call, TypeList *params, int variadic, const char *fname) {
    int n = call->list.len;
    if (n < params->len || (n > params->len && !variadic)) {
        diag_error(call->loc, "%s takes %d argument%s, got %d", fname, params->len, params->len == 1 ? "" : "s", n);
    }
    for (int i = 0; i < n; i++) {
        Type *pt = i < params->len ? params->items[i] : NULL;
        check_init(&call->list.items[i], pt);
        if (pt) {
            char *what = xfmt("argument %d of %s", i + 1, fname);
            coerce(&call->list.items[i], pt, what);
            free(what);
        }
    }
}

/* string literals handed to C stay plain C literals (format checking, char *) */
void raw_literals(Node *call) {
    for (int i = 0; i < call->list.len; i++) {
        Node *a = call->list.items[i];
        if (a->kind == N_STR) a->op = 1;
    }
}

static void check_unknown_args(Node *call) {
    for (int i = 0; i < call->list.len; i++) check_init(&call->list.items[i], NULL);
    raw_literals(call);
}

static Type *check_builtin(Node **slot, const char *name) {
    Node *n = *slot;
    if (strcmp(name, "print") == 0) {
        n->builtin = B_PRINT;
        for (int i = 0; i < n->list.len; i++) {
            Type *t = check_expr(&n->list.items[i], NULL);
            if (type_unqual(t)->kind == TY_VOID) diag_error(n->list.items[i]->loc, "cannot print a void value");
        }
        return ty_void;
    }
    if (strcmp(name, "assert") == 0) {
        n->builtin = B_ASSERT;
        if (n->list.len < 1 || n->list.len > 2) {
            diag_error(n->loc, "assert takes a condition and an optional message");
            return ty_void;
        }
        check_cond(&n->list.items[0]);
        if (n->list.len == 2) {
            check_expr(&n->list.items[1], ty_string);
            coerce(&n->list.items[1], ty_string, "assert message");
        }
        return ty_void;
    }
    if (strcmp(name, "panic") == 0) {
        n->builtin = B_PANIC;
        if (n->list.len != 1) {
            diag_error(n->loc, "panic takes one message");
            return ty_void;
        }
        check_expr(&n->list.items[0], ty_string);
        coerce(&n->list.items[0], ty_string, "panic message");
        return ty_void;
    }
    if (strcmp(name, "string") == 0) {
        if (n->list.len != 1) {
            diag_error(n->loc, "string(...) takes one value");
            return ty_string;
        }
        Type *t = check_expr(&n->list.items[0], NULL);
        Type *u = type_unqual(t);
        if (u->kind == TY_VOID) diag_error(n->loc, "cannot convert a void value to a string");
        int kind = type_is_char_ptr(u) ? CV_CSTR_TO_STR : CV_TO_STRING;
        if (u->kind == TY_STRING) {
            *slot = n->list.items[0];
            return ty_string;
        }
        *slot = wrap_conv(n->list.items[0], ty_string, kind);
        return ty_string;
    }
    return NULL;
}

/* literals in the variadic tail of a C call (printf formats and the like) */
static void raw_variadic(Node *call, int fixed) {
    for (int i = fixed; i < call->list.len; i++)
        if (call->list.items[i]->kind == N_STR) call->list.items[i]->op = 1;
}

static Type *call_function(Node *n, Sym *s) {
    n->a->sym = s;
    Type *ft = type_unqual(s->type);
    if (!ft || ft->kind != TY_FUNC) return ty_unknown;
    n->a->type = s->type;
    check_args(n, &ft->params, ft->variadic, s->name);
    if (ft->variadic) raw_variadic(n, ft->params.len);
    if (s->is_async) {
        n->builtin = B_ASYNC_CALL;
        prog.threads = 1;
        return type_future(ft->base);
    }
    n->builtin = B_FUNC;
    return ft->base;
}

static Type *call_value(Node *n, Type *ct, const char *what) {
    Type *u = type_unqual(ct);
    if (u->kind == TY_CLOSURE) {
        n->builtin = B_CLOSURE_CALL;
        check_args(n, &u->params, 0, what);
        return u->base;
    }
    Type *fn = u->kind == TY_FUNC ? u : (u->kind == TY_PTR && type_unqual(u->base)->kind == TY_FUNC ? type_unqual(u->base) : NULL);
    if (fn) {
        n->builtin = B_FNPTR_CALL;
        check_args(n, &fn->params, fn->variadic, what);
        raw_variadic(n, fn->params.len);
        return fn->base;
    }
    if (type_is_unknownish(u)) {
        n->builtin = B_UNKNOWN_CALL;
        check_unknown_args(n);
        return ty_unknown;
    }
    char *s = type_str(ct);
    diag_error(n->loc, "%s is not callable (type %s)", what, s);
    free(s);
    check_unknown_args(n);
    return ty_unknown;
}

Type *check_call(Node **slot, Type *expected) {
    Node *n = *slot;
    Node *callee = n->a;
    if (callee->kind == N_MEMBER) return check_method(slot, expected);
    if (callee->kind != N_IDENT) {
        Type *ct = check_expr(&n->a, NULL);
        return call_value(n, ct, "this expression");
    }
    const char *name = callee->name;
    Sym *s = lookup(name, callee->loc);
    if (!s) {
        Type *b = check_builtin(slot, name);
        if (b) return b;
    }
    if (s) {
        callee->sym = s;
        switch (s->kind) {
        case S_FUNC:
            return call_function(n, s);
        case S_VAR:
            check_expr(&n->a, NULL);
            return call_value(n, n->a->type, name);
        case S_TYPE:
            if (s->type && type_unqual(s->type)->kind == TY_STRUCT)
                diag_error(n->loc, "construct %s with %s{ ... } instead of calling it", name, name);
            else
                diag_error(n->loc, "'%s' is a type, not a function", name);
            check_unknown_args(n);
            return ty_unknown;
        default:
            check_expr(&n->a, NULL);
            return call_value(n, n->a->type, name);
        }
    }
    const char *last = NULL;
    for (const char *p = name; (p = strstr(p, "::")); p += 2) last = p;
    if (last) {
        char *prefix = xstrndup(name, (size_t)(last - name));
        Sym *e = lookup_quiet(prefix);
        free(prefix);
        if (e && e->kind == S_TYPE && e->type && type_unqual(e->type)->kind == TY_ENUM)
            return variant_ctor(n, e, last + 2, expected);
        diag_error(callee->loc, "unknown function '%s'", name);
        check_unknown_args(n);
        return ty_unknown;
    }
    n->builtin = B_UNKNOWN_CALL;
    callee->type = ty_unknown;
    check_unknown_args(n);
    return ty_unknown;
}
