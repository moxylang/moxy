// plain C must keep working inside .mxy files
#include <stdarg.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define SQUARE(x) ((x) * (x))
#define COUNT_OF(a) (sizeof(a) / sizeof((a)[0]))
#define BUF 64

typedef int(*binop)(int, int);
typedef struct Node Node;
struct Node {
    int value;
    Node *next;
};

typedef union {
    int i;
    float f;
    unsigned char bytes[4];
} Bits;

struct Flags {
    unsigned read: 1;
    unsigned write: 1;
    unsigned mode: 3;
};

enum Level { LOW = 1, MID = 5, HIGH = 10 };

static int add(int a, int b) { return a + b; }
static int mul(int a, int b) { return a * b; }

int sum(int count, ...) {
    va_list ap;
    va_start(ap, count);
    int total = 0;
    for (int i = 0; i < count; i++) total += va_arg(ap, int);
    va_end(ap);
    return total;
}

int compare(const void *a, const void *b) {
    return *(const int *)a - *(const int *)b;
}

void fill(char *out, size_t n, const char *name, int v) {
    snprintf(out, n, "%s=%d", name, v);
}

int grid[3][4];
const char *names[] = { "zero", "one", "two" };
static const int primes[5] = { 2, 3, 5, 7, 11 };

void main() {
    binop ops[2] = { add, mul };
    assert(ops[0](3, 4) == 7 && ops[1](3, 4) == 12);

    Node c = { 3, NULL };
    Node b = { 2, &c };
    Node a = { .value = 1, .next = &b };
    int total = 0;
    for (Node *n = &a; n; n = n->next) total += n->value;
    assert(total == 6);

    Bits bits;
    bits.i = 0;
    bits.bytes[0] = 1;
    assert(bits.i != 0);

    struct Flags fl = { 1, 0, 5 };
    assert(fl.read == 1 && fl.mode == 5);
    assert(HIGH - LOW == 9);

    assert(sum(4, 1, 2, 3, 4) == 10);
    int xs[] = { 5, 3, 9, 1 };
    qsort(xs, COUNT_OF(xs), sizeof(int), compare);
    assert(xs[0] == 1 && xs[3] == 9);
    assert(SQUARE(3 + 1) == 16);

    char buf[BUF];
    fill(buf, sizeof buf, "x", 42);
    assert(strcmp(buf, "x=42") == 0);
    char *p = buf;
    p += 2;
    assert(*p == '4');

    for (int i = 0, j = 10; i < j; i++, j--) grid[i % 3][j % 4] += 1;
    int k = 0;
    do { k++; } while (k < 5);
    assert(k == 5);

    int **pp = malloc(2 * sizeof(int *));
    pp[0] = &k;
    assert(**pp == 5);
    free(pp);

    int x = 0;
    switch (k) {
        case 1... 4: x = 1; break;
        case 5: x = 5; /* fallthrough */
        default: x += 1;
    }
    assert(x == 6);

    int tries = 0;
    retry:
    tries++;
    if (tries < 3) goto retry;
    assert(tries == 3);

    assert(strlen(names[2]) == 3 && primes[4] == 11);
    unsigned long big = 1UL << 40;
    assert(big > 1000000000UL);
    double d = (double)7 / 2;
    assert(d == 3.5);
    int ternary = k > 3 ? (k > 4 ? 2 : 1) : 0;
    assert(ternary == 2);
    long count = (long)COUNT_OF(primes);
    assert(count == 5);
}
