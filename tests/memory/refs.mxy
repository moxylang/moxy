// ref structs are shared, reference counted objects; weak breaks cycles
ref struct Node {
    string name;
    Node[] children;
    weak Node parent;
}

Node add_child(Node parent, string name) {
    Node child = Node{ .name = name, .parent = parent };
    parent.children.push(child);
    return child;
}

string path(Node n) {
    Node p = n.parent;
    if (p == null) { return n.name; }
    return path(p) + "/" + n.name;
}

void main() {
    Node root = Node{ .name = "root" };
    Node usr = add_child(root, "usr");
    Node bin = add_child(usr, "bin");
    assert(path(bin) == "root/usr/bin");

    Node same = usr;
    same.name = "home";
    assert(usr.name == "home");
    assert(path(bin) == "root/home/bin");
    assert(root.children.len == 1 && root.children[0] == usr);

    Node orphan = Node{ .name = "orphan" };
    Node kid = add_child(orphan, "kid");
    orphan = null;
    assert(kid.parent == null);
}
