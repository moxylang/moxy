void main() {
    int[] xs = [1, 2, 3];
    xs = [5, 6];
    assert(xs.len == 2 && xs[0] == 5);
    xs = [];
    assert(xs.is_empty());

    map[string, int] m = { "a": 1 };
    m = { "b": 2, "c": 3 };
    assert(m.len == 2 && !m.has("a"));

    string s = "x";
    for i in 0..3 { s = s + "y"; }
    s += "!";
    assert(s == "xyyy!");

    int[] ys = xs + [7, 8];
    ys += [9];
    assert(ys.len == 3);
}
