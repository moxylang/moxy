Future<int> classify(int x) {
    if (x > 100) { return 2; }
    for i in 0..x {
        if (i == 5) { return 1; }
    }
    return 0;
}

Future<string> shout(string s) {
    return s.upper() + "!";
}

Future<int[]> squares(int n) {
    int[] out = [];
    for i in 0..n { out.push(i * i); }
    return out;
}

void main() {
    Future<int> a = classify(500);
    Future<int> b = classify(10);
    Future<int> c = classify(2);
    assert(await a == 2 && await b == 1 && await c == 0);
    assert(await a == 2);
    assert(await shout("hi") == "HI!");
    int[] sq = await squares(5);
    assert(sq.len == 5 && sq[4] == 16);
    Future<int> unused = classify(1);
}
